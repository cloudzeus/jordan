{
  "name": "jordan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "seed:db": "node ./scripts/seed.js",
    "seed:regions": "npx tsx prisma/seeds/regions.ts",
    "backfill:regions": "npx tsx scripts/backfill-regions.ts",
    "templates:seed": "npx tsx --import ./scripts/templates/register.mjs scripts/templates/seed-from-pdf.ts",
    "templates:migrate-field-rules": "npx tsx --import ./scripts/templates/register.mjs scripts/templates/migrate-field-rules.ts",
    "check-updates": "node ./scripts/check-updates.js",
    "wiki:new": "node ./scripts/wiki/new.mjs",
    "wiki:index": "node ./scripts/wiki/build-index.mjs",
    "wiki:screenshots": "node ./scripts/wiki/screenshot.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "permissions:sync": "npx tsx scripts/sync-permissions.ts",
    "preview:start": "bash scripts/preview.sh start",
    "preview:update": "bash scripts/preview.sh update",
    "preview:restart": "bash scripts/preview.sh restart",
    "assistant:reindex": "npx tsx --import ./scripts/templates/register.mjs scripts/assistant-reindex.ts"
  },
