  value     String // η ίδια η τιμή (email ή αριθμός)
  isPrimary Boolean     @default(false)
  isActive  Boolean     @default(true)
  notes     String?
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([companyId, kind])
  @@index([value])
}

model CompanyContact {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Identity
  firstName        String?
  lastName         String?
  fullName         String // derived/required (το γεμίζει ο client)
  role             String? // περιγραφή (π.χ. "Λογιστής", "Διευθυντής Πωλήσεων")
  department       String?
  // Communication
