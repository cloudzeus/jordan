// ============================================================
// AI usage & cost tracking (SUPER_ADMIN only)
// ============================================================

enum AiScope {
  OCR_TEXT // DeepSeek text model on digital PDF
  OCR_VISION // Gemini / VLM vision call (image or scanned PDF page)
  OCR_VISION_RETRY // upgraded-model retry firing on missing-fields
  TRANSLATION // DeepSeek translation
  TAX_FORM // Tax-form field extraction via vision pipeline
  ASSISTANT // Air Jordan: συνομιλία, embeddings, μεταγραφή φωνής
  OTHER
}

model AiUsage {
  id           String   @id @default(cuid())
  scope        AiScope
  provider     String // "deepseek" | "gemini" | "openai" | ...
  model        String // "deepseek-chat" | "gemini-2.5-flash" | ...
  operation    String? // free-form (e.g. "ocr.invoice", "i18n.batch")
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  inputCost    Decimal? @db.Decimal(12, 6) // USD
  outputCost   Decimal? @db.Decimal(12, 6) // USD
  totalCost    Decimal? @db.Decimal(12, 6) // USD
  durationMs   Int?
  userId       String?
  refType      String? // "OcrDocument" etc.
  refId        String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([scope])
  @@index([model])
  @@index([userId])
}

model OcrInvoiceItem {
  id               String      @id @default(cuid())
  documentId       String
  document         OcrDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  rowIndex         Int
  code             String?
  name             String
  quantity         Decimal?    @db.Decimal(18, 4)
  price            Decimal?    @db.Decimal(18, 4)
  discount         Decimal?    @db.Decimal(18, 4)
  vatRate          Decimal?    @db.Decimal(5, 2)
  total            Decimal?    @db.Decimal(18, 4)
  // SoftOne item match (filled by correlation; null = δεν βρέθηκε).
  softoneMtrl      Int?
  softoneCode      String?
  softoneName      String?
  softoneIsService Boolean?
  softoneMatchedBy String? // code2 | code1 | code | manual | memory | skipped
  // Αντιστοίχιση σε έξοδο SoftOne (EXPENSES/EXPN) αντί για είδος.
  softoneExpn      Int?
  // Αντιστοίχιση σε ΧΡΕΟΠΙΣΤΩΣΗ SoftOne (LINEITEM → MTRL με SODTYPE 53). Ξεχωριστή στήλη από το
  // `softoneMtrl`: και οι δύο κρατούν MTRL, αλλά μόνο η χρεοπίστωση μπαίνει σε γραμμή LINLINES.
  softoneLinMtrl   Int?
  // Αντιστοίχιση σε ΠΑΓΙΟ SoftOne (ASSET → MTRL με SODTYPE 54) — καταχωρείται σε γραμμή ASSLINES
  // παραστατικού αγορών. Πάντα χειροκίνητη απόφαση: η μνήμη δεν μαθαίνει πάγια (κάθε πάγιο είναι μοναδικό).
  softoneAsset     Int?
  // Αναλυτική ανά γραμμή: κέντρο κόστους, έργο, κατηγορία δραστηριότητας. Και τα τρία είναι
  // ΠΡΟΑΙΡΕΤΙΚΑ στο SoftOne — δεν μπλοκάρουν ποτέ καταχώριση.
  softoneCostCntr  Int?
  softonePrjc      Int?
  softonePrjcStage Int?

  /**
   * Επιμερισμός της γραμμής σε ΠΟΛΛΟΥΣ λογαριασμούς — κενό = η γραμμή πάει ακέραιη.
   */
  allocations OcrInvoiceItemAllocation[]

  @@index([documentId])
  @@index([softoneMtrl])
  @@index([softoneExpn])
  @@index([softoneLinMtrl])
  @@index([softoneAsset])
}

// Επιμερισμός ΜΙΑΣ γραμμής παραστατικού σε 2+ λογαριασμούς γενικής.
//
// ΓΙΑΤΙ ΥΠΑΡΧΕΙ: μια δαπάνη δεν ανήκει πάντα σε έναν λογαριασμό — ένα τιμολόγιο εστιατορίου
// μπορεί να σπάει σε τροφή, ποτά και φιλοξενία. Το `OcrInvoiceItem` κρατά ΜΙΑ αντιστοίχιση
// (`softoneMtrl` | `softoneExpn` | `softoneLinMtrl`), οπότε ο επιμερισμός χρειάζεται δικές του
// γραμμές.
//
// ΠΩΣ ΦΤΑΝΕΙ ΣΤΟ SoftOne: κάθε γραμμή `LINLINES` κουβαλά ΕΝΑ `MTRL` και ΕΝΑ ποσό, άρα ένας
// επιμερισμός σε 3 λογαριασμούς γίνεται **3 γραμμές LINLINES** — όχι μία γραμμή με τρεις
// λογαριασμούς. Το ERP δεν εκφράζει το δεύτερο (το `EXPANAL` δεν έχει καν πεδίο λογαριασμού).
//
// ΠΟΙΟΣ ΚΕΡΔΙΖΕΙ: καμία εγγραφή εδώ = η γραμμή συμπεριφέρεται όπως σήμερα. Μία ή περισσότερες
// = ο επιμερισμός υπερισχύει της μονής αντιστοίχισης.
model OcrInvoiceItemAllocation {
  id     String         @id @default(cuid())
  itemId String
  item   OcrInvoiceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /**
   * Σειρά εμφάνισης και σταθερή ταυτότητα του επιμερισμού μέσα στη γραμμή.
   */
  order  Int

  /**
   * Η ΧΡΕΟΠΙΣΤΩΣΗ (MTRL με SODTYPE 53) που δέχεται το κομμάτι. Στο tenant ο ΚΩΔΙΚΟΣ της
   * χρεοπίστωσης ΕΙΝΑΙ ο λογαριασμός γενικής (π.χ. «64.01.00.0000»), και η 4η βαθμίδα
   * κωδικοποιεί τη μεταχείριση ΦΠΑ (…0024 = 24 %, …0000 = άνευ, …0099 = ΧΔΕ).
   */
  registryMtrl Int
  /**
   * ΠΟΙΟ μητρώο: `LINEITEM` χρεοπίστωση (SODTYPE 53, διπλογραφικά) ή `SXACCOUNT` λογαριασμός
   * εσόδων/εξόδων (SODTYPE 61, απλογραφικά). Και τα δύο είναι `MTRL`, οπότε χωρίς αυτό ο αριθμός
   * είναι διφορούμενος — και η εφαρμογή δίνεται σε πελάτες και των δύο κατηγοριών βιβλίων.
   */
  kind         String  @default("LINEITEM")
  /**
   * Ο λογαριασμός όπως διαβάστηκε ΤΗ ΣΤΙΓΜΗ της επιλογής. Αντίγραφο σκοπίμως: αν αύριο αλλάξει
   * ή σβηστεί η εγγραφή στο ERP, πρέπει να εξακολουθεί να φαίνεται πού στάλθηκε το ποσό.
   */
  accountCode  String?

  /**
   * Ό,τι ΔΗΛΩΣΕ ο χρήστης. Είσοδος της φόρμας — το άθροισμα οφείλει να κάνει 100.
   */
  percent Decimal @db.Decimal(7, 4)
  /**
   * Ό,τι ΣΤΕΛΝΕΤΑΙ. Υπολογίζεται από το ποσοστό, με τον **τελευταίο** επιμερισμό να απορροφά το
   * υπόλοιπο στρογγυλοποίησης, ώστε το άθροισμα να κλείνει στο σεντ με το σύνολο της γραμμής.
   * Αποθηκεύεται αντί να ξαναϋπολογίζεται, για να μη βγάλει άλλο νούμερο άλλος κώδικας αργότερα.
   */
  amount  Decimal @db.Decimal(18, 4)

  /**
   * Αναλυτικά του ΚΟΜΜΑΤΙΟΥ (κέντρο κόστους / έργο / φάση). Κενά = της γραμμής. Επιτρέπουν τον ΙΔΙΟ
   * λογαριασμό σε άλλο κέντρο κόστους (ρεύμα 60% Παραγωγή / 40% Διοίκηση) ή σε άλλο ΕΡΓΟ (SoftOne
   * `PRJC`, π.χ. ένα αεροπορικό «Έξοδα Ταξιδίων» 50/50 σε δύο έργα).
   */
  costCntr  Int?
  prjc      Int?
  prjcStage Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemId, order])
  @@index([itemId])
  @@index([registryMtrl])
}

// ============================================================
// Tax-form templates, per-company financial values, program required fields
// ============================================================

model TaxFormTemplate {
  id               String                 @id @default(cuid())
  code             String
  name             String
  year             Int?
  description      String?                @db.Text
  status           TaxTemplateStatus      @default(DRAFT)
  sampleStorageKey String?
  samplePageCount  Int?
  sampleThumbUrl   String?
  createdById      String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  fields           TaxFormTemplateField[]
  requiredBy       ProgramRequiredField[]
  documents        OcrDocument[]

  @@unique([code, year])
  @@index([status])
}

model TaxFormTemplateField {
  id         String             @id @default(cuid())
  templateId String
  template   TaxFormTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fieldKey   String
  label      String
  section    String?
  valueType  FinancialValueType @default(CURRENCY)
  kind       TaxFieldKind       @default(SINGLE)
  config     Json? // for TABLE (records): { columns: string[] }
  regionHint Json?
  aiHint     String?            @db.Text
  required   Boolean            @default(false)
  order      Int                @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([templateId, fieldKey])
  @@index([templateId])
}

model CompanyFinancialValue {
  id               String               @id @default(cuid())
  companyId        String
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fieldKey         String
  templateId       String?
  year             Int
  value            Decimal?             @db.Decimal(18, 2) // numeric value (SINGLE/SERIES point)
  valueText        String?              @db.Text // for DATE / free text values
  valueJson        Json? // for TABLE (records): array of objects
  kind             TaxFieldKind         @default(SINGLE)
  valueType        FinancialValueType
  source           FinancialValueSource @default(OCR)
  sourceDocumentId String?
  confidence       Float?
  verified         Boolean              @default(false)
  verifiedById     String?
  periodStart      DateTime?
  periodEnd        DateTime?
  validUntil       DateTime?
  note             String?              @db.Text
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([companyId, fieldKey, year])
  @@index([companyId])
  @@index([fieldKey, year])
}

model ProgramRequiredField {
  id         String          @id @default(cuid())
  programId  String
  program    Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  templateId String
  template   TaxFormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fieldKey   String
  yearsBack  Int             @default(1)
  mandatory  Boolean         @default(true)
  order      Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([programId, templateId, fieldKey])
  @@index([programId])
}

// ============================================================
// Self-assessment questionnaire (per Program) & company evaluation
// ============================================================

enum QuestionnaireScoringModel {
  WEIGHTED
  POINTS_SUM
}

enum QuestionnaireStatus {
  DRAFT
  READY
}

enum QuestionAnswerType {
  BOOLEAN
  SINGLE_CHOICE
  NUMERIC
  SCALE
}

enum AssessmentStatus {
  DRAFT
  COMPLETED
}

enum AssessmentVerdict {
  ELIGIBLE
  NOT_ELIGIBLE
  NEEDS_REVIEW
}

enum AnswerSource {
  AUTO
  MANUAL
}

model ProgramQuestionnaire {
  id               String                    @id @default(cuid())
  programId        String                    @unique
  program          Program                   @relation(fields: [programId], references: [id], onDelete: Cascade)
  title            String?
  description      String?                   @db.Text
  scoringModel     QuestionnaireScoringModel @default(WEIGHTED)
  threshold        Decimal?                  @db.Decimal(8, 2)
  maxScore         Decimal?                  @db.Decimal(8, 2)
  sourceNote       String?
  status           QuestionnaireStatus       @default(DRAFT)
  generatedModel   String?
  generatedAt      DateTime?
  computedCriteria Json? // ① computed criteria (variables↔E3 mappings, formula, bands, weight)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  questions        ProgramQuestion[]
  assessments      CompanyAssessment[]
}

model ProgramQuestion {
  id              String                  @id @default(cuid())
  questionnaireId String
  questionnaire   ProgramQuestionnaire    @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  code            String?
  text            String                  @db.Text
  criterionRef    String?
  helpText        String?                 @db.Text
  answerType      QuestionAnswerType      @default(SINGLE_CHOICE)
  weight          Decimal?                @db.Decimal(8, 2)
  maxPoints       Decimal?                @db.Decimal(8, 2)
  companyField    String?
  order           Int                     @default(0)
  options         ProgramQuestionOption[]
  answers         AssessmentAnswer[]

  @@index([questionnaireId])
}

model ProgramQuestionOption {
  id         String          @id @default(cuid())
  questionId String
  question   ProgramQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  points     Decimal         @default(0) @db.Decimal(8, 2)
  order      Int             @default(0)

  @@index([questionId])
}

model CompanyAssessment {
  id                  String                @id @default(cuid())
  companyId           String
  company             Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  programId           String
  program             Program               @relation(fields: [programId], references: [id], onDelete: Cascade)
  questionnaireId     String?
  questionnaire       ProgramQuestionnaire? @relation(fields: [questionnaireId], references: [id], onDelete: SetNull)
  eligible            Boolean?
  eligibilityResult   Json?
  questionnaireScore  Decimal?              @db.Decimal(8, 2)
  questionnaireMax    Decimal?              @db.Decimal(8, 2)
  questionnairePassed Boolean?
  overallVerdict      AssessmentVerdict     @default(NEEDS_REVIEW)
  status              AssessmentStatus      @default(DRAFT)
  notes               String?               @db.Text
  createdById         String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  answers             AssessmentAnswer[]

  @@index([companyId])
  @@index([programId])
  @@index([programId, eligible])
}

model AssessmentAnswer {
  id               String            @id @default(cuid())
  assessmentId     String
  assessment       CompanyAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId       String
  question         ProgramQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  valueBool        Boolean?
  valueNumber      Decimal?          @db.Decimal(14, 4)
  valueText        String?           @db.Text
  selectedOptionId String? // intentional loose ref (no FK): questionnaire regen full-replaces options; we keep historical answers
  pointsAwarded    Decimal?          @db.Decimal(8, 2)
  source           AnswerSource      @default(MANUAL)

  @@index([assessmentId])
  @@index([questionId])
}

// ─── Πρότυπα εξαγωγής προμηθευτή (extraction templates) ─────────────────────
// Spec: docs/superpowers/specs/2026-09-09-extraction-templates-design.md

enum TemplateMode {
  AUTO
  SEMI_AUTO
  MANUAL
}

enum TemplateStatus {
  DRAFT
  ACTIVE
}

enum TemplateFieldKind {
  SINGLE
  TABLE
}

enum TemplateValueType {
  TEXT
  NUMBER
  CURRENCY
  DATE
  LIST
}

enum MappingTarget {
  INVOICE
  EXCEL
}

enum TemplateRunStatus {
  EXTRACTED
  REVIEW
  BLOCKED
  POSTED
  FAILED
}

enum TemplateSampleStatus {
  PENDING
  READ
  VERIFIED
}

enum TemplateJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELLED
}

enum TemplateJobItemStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model ExtractionTemplate {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique // auto από name — κλειδί του JSON εξόδου
  department         String? // τμήμα / κατηγορία (ελεύθερο κείμενο)
  vatNumber          String? // ΑΦΜ προμηθευτή — προαιρετική συσχέτιση
  traderTrdr         Int? // → SoftoneTrader.trdr (προαιρετικό)
  supplierName       String? // denormalized για λίστες
  mode               TemplateMode        @default(MANUAL)
  status             TemplateStatus      @default(DRAFT)
  version            Int                 @default(1)
  sampleStorageKey   String? // Bunny private — δείγμα εικόνας/PDF
  sampleMimeType     String?
  samplePageCount    Int?
  sampleThumbUrl     String?
  // Αποτύπωμα διάταξης του κύριου δείγματος (§14.7) — { afm, issuer, words[], aspect }.
  fingerprint        Json?
  // Κατώφλια ενεργοποίησης (§11): 0 δείγματα = χωρίς έλεγχο εκπαίδευσης.
  minTrainingScore   Float               @default(0.9)
  minTrainingSamples Int                 @default(3)
  trainingScore      Float? // τελευταίος υπολογισμένος συνολικός βαθμός 0-1
  verifiedSamples    Int                 @default(0) // πλήθος δειγμάτων σε status VERIFIED
  notifyEmails       String? // ";"-separated (NOTIFY)
  timesUsed          Int                 @default(0)
  createdById        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  fields             TemplateField[]
  mappings           TemplateMapping[]
  conditions         TemplateCondition[]
  runs               TemplateRun[]
  samples            TemplateSample[]
  jobs               TemplateJob[]

  @@index([vatNumber, status])
}

model TemplateField {
  id         String             @id @default(cuid())
  templateId String
  template   ExtractionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key        String // slug (auto από label), σταθερό
  label      String
  kind       TemplateFieldKind  @default(SINGLE)
  valueType  TemplateValueType  @default(TEXT)
  color      String // hex, μοναδικό μέσα στο πρότυπο
  region     Json? // { page:number, bbox:[x,y,w,h] } 0-1
  columns    Json? // TABLE → [{ key, label, valueType }]
  aiHint     String?            @db.Text
  required   Boolean            @default(false)
  order      Int                @default(0)
  // §17.2 — τελευταία επιτυχημένη θέση: { page, bbox:[x,y,w,h], at, n } (κινητός μέσος όρος, n ≤ 10).
  lastGood   Json?

  @@unique([templateId, key])
  @@index([templateId])
}

model TemplateMapping {
  id         String             @id @default(cuid())
  templateId String
  template   ExtractionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String             @default("default")
  target     MappingTarget
  isDefault  Boolean            @default(true)
  rows       Json // INVOICE: [{fieldKey, invoiceKey}] · EXCEL: [{fieldKey, column, order}]

  @@unique([templateId, name])
}

model TemplateCondition {
  id         String             @id @default(cuid())
  templateId String
  template   ExtractionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  order      Int                @default(0)
  isActive   Boolean            @default(true)
  logic      String             @default("AND") // AND | OR
  clauses    Json // [{ fieldKey, op, value }]
  actions    Json // [{ type, params }]

  @@index([templateId, order])
}

model TemplateRun {
  id              String             @id @default(cuid())
  templateId      String
  template        ExtractionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateVersion Int
  documentId      String
  document        OcrDocument        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status          TemplateRunStatus
  trigger         String             @default("upload") // upload | manual | reextract
  error           String?            @db.Text
  values          Json // { key: FieldValue }
  // Φάκελος εξόδου v3: { template, version, extractedAt, file, documentId, document } (spec §17.1).
  output          Json?
  matched         Json // [{ id, name, actions }]
  // { review: string[], blocked: string[], fields: Record<string, 'review'|'blocked'>, notified: string[],
  //   baseOcr: Record<string, unknown> }
  // baseOcr = what the base OCR read for the cross-checked keys (totalAmount, subtotal, vatAmount,
  // invoiceNumber, date) BEFORE this run projected over document.extractedData. Every later re-check of
  // «Ασυμφωνία …» (a manual correction, a per-field re-read) compares against it — comparing with the
  // live extractedData would compare the template with its own projection. Runs written before this
  // existed have no baseOcr and keep the mismatch reasons they already carry.
  flags           Json?
  mappingName     String
  model           String?
  tokensUsed      Int?
  durationMs      Int?
  createdAt       DateTime           @default(now())

  @@index([documentId])
  @@index([documentId, createdAt])
  @@index([templateId, createdAt])
}

// Δείγματα εκπαίδευσης (spec §11) — πολλά αρχεία ανά πρότυπο, με επιβεβαιωμένες τιμές.
model TemplateSample {
  id          String               @id @default(cuid())
  templateId  String
  template    ExtractionTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fileName    String
  storageKey  String
  mimeType    String
  pageCount   Int?
  status      TemplateSampleStatus @default(PENDING)
  expected    Json? // { fieldKey: value } επιβεβαιωμένο από χρήστη
  lastResult  Json? // { fieldKey: { raw, value, source, match } }
  score       Float? // 0-1 ποσοστό πεδίων που ταιριάζουν
  fingerprint Json? // §14.7 — { afm, issuer, words[], aspect }
  isPrimary   Boolean              @default(false) // το δείγμα πάνω στο οποίο σχεδιάστηκαν οι περιοχές
  createdById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([templateId])
}

// Εργασίες μαζικής σάρωσης (spec §12).
model TemplateJob {
  id              String             @id @default(cuid())
  templateId      String
  template        ExtractionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateVersion Int
  status          TemplateJobStatus  @default(QUEUED)
  title           String? // τίτλος της παρτίδας, όπως τον έγραψε ο χρήστης
  reference       String? // ελεύθερη σήμανση/κωδικός του χρήστη
  docDate         DateTime? // ημερομηνία αναφοράς που δίνει ο χρήστης (≠ createdAt)
  description     String?
  notifyEmails    String? // comma-separated· κενό → τα emails του προτύπου
  total           Int                @default(0)
  done            Int                @default(0)
  failed          Int                @default(0)
  createdById     String?
  createdAt       DateTime           @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  items           TemplateJobItem[]

  @@index([status, createdAt])
  @@index([templateId, createdAt])
}

model TemplateJobItem {
  id         String                @id @default(cuid())
  jobId      String
  job        TemplateJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  order      Int
  fileName   String
  storageKey String
  mimeType   String
  size       Int
  status     TemplateJobItemStatus @default(QUEUED)
  page       Int? // πλήθος σελίδων του αρχείου (για το page-image)
  values     Json? // { fieldKey: FieldValue }
  matched    Json?
  flags      Json?
  model      String?
  tokensUsed Int?
  durationMs Int?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([jobId, order])
  @@index([status])
}

// Έξοδα SoftOne (EditMaster EXPENSES, πίνακας EXPN) — μητρώο για την αντιστοίχιση γραμμών.
model SoftoneExpense {
  id             Int      @id @default(autoincrement())
  expn           Int      @unique // SoftOne EXPN id
  code           String // CODE
  name           String // NAME
  vat            String? // VAT (κατηγορία ΦΠΑ)
  isActive       Boolean  @default(true)
  syncedAt       DateTime @default(now())
  // Χαρακτηρισμός myDATA του ΜΗΤΡΩΟΥ (όχι της γραμμής). Το EXPN κρατά δύο ζεύγη: εσόδων και
  // εξόδων (…X). Για παραστατικά που λαμβάνουμε ισχύει το ζεύγος ΕΞΟΔΩΝ.
  classType      Int? // CLASSTYPE       (εσόδων)
  classTypeX     Int? // CLASSTYPEX      (εξόδων)
  classCategory  Int? // CLASSCATEGORY   (εσόδων)
  classCategoryX Int? // CLASSCATEGORYEX (εξόδων)
  myDataVprc     Int? // MYDATAVPRC (κατηγορία φόρων)

  @@index([name])
  @@index([code])
}

// Χρεοπιστώσεις SoftOne — object LINEITEM (EditMaster «Χρεοπιστώσεις») → πίνακας MTRL με
// SODTYPE 53 (51 είδη · 52 υπηρεσίες · 53 χρεοπιστώσεις · 54 πάγια). Είναι ΑΥΤΕΣ που δέχεται το
// `MTRL` μιας γραμμής LINLINES («Ειδικές συναλλαγές»), όχι τα είδη/υπηρεσίες ούτε τα έξοδα.
model SoftoneLineItem {
  id             Int       @id @default(autoincrement())
  mtrl           Int       @unique // SoftOne MTRL id (SODTYPE 53)
  code           String // CODE
  name           String // NAME
  vat            String? // VAT (κατηγορία ΦΠΑ)
  mtrType        Int? // MTRTYPE («Τύπος», editor $LINTYPE) — το θέλει η γραμμή LINLINES
  mtrCategory    Int? // MTRCATEGORY → SoftoneLineCategory.mtrCategory (κατηγορία δαπάνης)
  isActive       Boolean   @default(true)
  syncedAt       DateTime  @default(now())
  // Χαρακτηρισμός myDATA του ΜΗΤΡΩΟΥ — η γραμμή LINLINES δεν έχει πεδίο χαρακτηρισμού.
  classType      Int? // CLASSTYPE
  classCategory  Int? // CLASSCATEGORY
  myDataCode     String? // MYDATACODE («Στοιχεία εσόδων / εξόδων»)
  myDataVprc     Int? // MYDATAVPRC
  // Λογαριασμός γενικής λογιστικής της χρεοπίστωσης — `MTRL.ACNMSK` («Γενικής», editor ACNTGL).
  // ΠΡΟΣΟΧΗ, δύο διαφορετικά «κενά»: `acnmskSyncedAt = null` σημαίνει ότι ο συγχρονισμός δεν έχει
  // διαβάσει ΑΚΟΜΗ το πεδίο (άγνωστο), ενώ `acnmsk = null` με `acnmskSyncedAt` γεμάτο σημαίνει ότι
  // το SoftOne το έχει ΚΕΝΟ. Το «δεν ξέρω» δεν επιτρέπεται να διαβαστεί ως «λείπει».
  // Μπορεί να είναι ΜΑΣΚΑ με `*` (π.χ. «32.*»), όχι μόνο πλήρης κωδικός — βλ. `lib/ocr/account-check.ts`.
  acnmsk         String?
  acnmskSyncedAt DateTime?

  @@index([name])
  @@index([code])
  @@index([mtrCategory])
}

// Λογιστικό σχέδιο SoftOne — πίνακας ACNT (Γενική λογιστική). Καθρέφτης ΜΟΝΟ ΓΙΑ ΑΝΑΓΝΩΣΗ: με αυτόν
// ο έλεγχος πριν την καταχώριση λέει ΣΕ ΠΟΙΟΝ λογαριασμό θα πάει κάθε γραμμή και αν αυτός υπάρχει.
// Ο πελάτης έχει ΕΓΛΣ: 4 βαθμίδες, με την 4η να είναι κατάληξη συντελεστή ΦΠΑ (…0024, …0013).
model SoftoneAccount {
  id         Int      @id @default(autoincrement())
  acnt       Int      @unique // ACNT (κλειδί)
  code       String   @unique // CODE, π.χ. «61.02.00.0024»
  name       String // NAME
  grade      Int? // ACNGRADE — βαθμίδα 1..4
  // Ο κωδικός χωρίς το τελευταίο τμήμα («61.02.00.0024» → «61.02.00»). Υπολογίζεται εδώ, δεν
  // έρχεται από το SoftOne· κενό για πρωτοβάθμιους.
  parentCode String?
  sodtype    Int? // SODTYPE (89 γενική · 90 ομάδα 9 αναλυτικής)
  // ACNMOVING «Κινείται»: ο λογαριασμός δέχεται εγγραφές. `null` = δεν διαβάστηκε — ΑΓΝΩΣΤΟ, ποτέ
  // «κινείται». (Στον πελάτη ΔΕΝ υπάρχουν GLMASTER / ISFINAL — το σχέδιο είναι ACNT, η σημαία ACNMOVING.)
  postable   Boolean?
  isActive   Boolean  @default(true)
  syncedAt   DateTime @default(now())

  @@index([parentCode])
}

// Λογαριασμοί ΕΣΟΔΩΝ / ΕΞΟΔΩΝ SoftOne — object `SXACNT`, πίνακας `MTRL` με **SODTYPE 61**
// (51 είδη · 52 υπηρεσίες · 53 χρεοπιστώσεις · 54 πάγια · **61 λογαριασμοί εσόδων/εξόδων**).
//
// ΓΙΑΤΙ ΞΕΧΩΡΙΣΤΟΣ ΚΑΘΡΕΦΤΗΣ: είναι το μητρώο που δέχεται η ενότητα **1261 «Παραστατικά εξόδων»**
// (object `SXDOCSEX`). Εκεί ο επιμερισμός μιας δαπάνης σε πολλούς λογαριασμούς είναι NATIVE —
// ο πίνακας `SXEXPANAL` κρατά `(γραμμή, SXACNT, ποσό)` — σε αντίθεση με τη σειρά πιστωτών, όπου
// ο ίδιος επιμερισμός γίνεται N γραμμές `LINLINES`.
//
// ΠΡΟΣΟΧΗ ΣΤΗΝ ΑΝΑΓΝΩΣΗ: το `GetTable SXACNT` σκάει με «Ole exception» σε αυτή την εγκατάσταση.
// Ο δρόμος που δουλεύει είναι `GetTable MTRL FILTER=SODTYPE=61` (raw τιμές) — ή, εναλλακτικά,
// `getBrowserInfo OBJECT=SXACNT` που δίνει ετικέτες αντί για κωδικούς.
model SoftoneSxAccount {
  id         Int      @id @default(autoincrement())
  mtrl       Int      @unique // SoftOne MTRL id (SODTYPE 61)
  code       String // CODE — ο κωδικός του λογαριασμού
  name       String // NAME
  /**
   * MTRTYPE — ΤΙ είδους λογαριασμός: 1 έσοδα (208) · **2 έξοδα (167)** · 3 δημοτικός φόρος (14) ·
   * 4 ΕΛΓΑ (1) · 5 ΦΠΑ πωλήσεων (94) · 6 ΦΠΑ αγορών (54) · 8 ταμειακές κινήσεις (4).
   * Για τα ΕΙΣΕΡΧΟΜΕΝΑ παραστατικά μας ενδιαφέρει ο **2**· τα ΦΠΑ τα συμπληρώνει το SoftOne.
   */
  mtrType    Int?
  /**
   * SOCLMNS — η στήλη βιβλίων όπου κινείται ο λογαριασμός.
   */
  soClmns    Int?
  vat        String? // VAT (κατηγορία ΦΠΑ)
  myDataCode String? // MYDATACODE — χαρακτηρισμός μητρώου
  isActive   Boolean  @default(true)
  syncedAt   DateTime @default(now())

  @@index([name])
  @@index([code])
  @@index([mtrType])
}

// Κατηγορίες δαπανών SoftOne — object LINCATEGORY (EditMaster «Κατηγορίες δαπανών») → πίνακας
// MTRCATEGORY με SODTYPE 53. Είναι η ομαδοποίηση ΠΑΝΩ από τις χρεοπιστώσεις (`LINEITEM.MTRCATEGORY`),
// όχι ξεχωριστή λίστα δαπανών· τη χρησιμοποιεί η ουρά για να στενέψει την αναζήτηση χρεοπίστωσης.
model SoftoneLineCategory {
  id              Int      @id @default(autoincrement())
  mtrCategory     Int      @unique // SoftOne MTRCATEGORY id (SODTYPE 53)
  code            String // CODE (σύντμηση)
  name            String // NAME (περιγραφή)
  vat             String? // VAT (προεπιλεγμένη κατηγορία ΦΠΑ της κατηγορίας)
  acnmsk          String? // ACNMSK (λογαριασμός γενικής)
  // `false` = η εγκατάσταση δεν εξέθεσε SODTYPE στον MTRCATEGORY, οπότε ο κατάλογος μπορεί να
  // περιέχει και κατηγορίες ειδών/υπηρεσιών/παγίων. Το UI το λέει αντί να το κρύβει.
  sodtypeFiltered Boolean  @default(true)
  isActive        Boolean  @default(true)
  syncedAt        DateTime @default(now())

  @@index([name])
  @@index([code])
}

// Κέντρα κόστους SoftOne — object PRSCOSTCNTR («Κέντρα κόστους») → DB πίνακας COSTCNTR.
// Μπαίνουν ΑΝΑ ΓΡΑΜΜΗ (`COSTCNTR`) σε ITELINES / SRVLINES / LINLINES· το EXPANAL ΔΕΝ το έχει.
model SoftoneCostCenter {
  id       Int      @id @default(autoincrement())
  costcntr Int      @unique // SoftOne COSTCNTR (Integer key)
  code     String // CODE (σύντμηση)
  name     String // NAME (περιγραφή)
  name2    String? // NAME2
  sohCode  String? // SOHCODE (κωδικός ιεραρχίας)
  acnmsk   String? // ACNMSK (λογαριασμός)
  isActive Boolean  @default(true)
  syncedAt DateTime @default(now())

  @@index([name])
  @@index([code])
}

// Έργα SoftOne — object PRJC («Έργα») → DB πίνακας PRJC. Μπαίνουν ΑΝΑ ΓΡΑΜΜΗ (`PRJC`).
// Το `trdr` επιτρέπει να στενέψει η λίστα στα έργα ΤΟΥ εκδότη του παραστατικού.
model SoftoneProject {
  id       Int      @id @default(autoincrement())
  prjc     Int      @unique // SoftOne PRJC
  code     String // CODE
  name     String // NAME
  trdr     Int? // TRDR («Πελάτης») — για φιλτράρισμα ανά συναλλασσόμενο
  prjType  Int? // PRJTYPE
  isActive Boolean  @default(true)
  syncedAt DateTime @default(now())

  // Στοιχεία για τη σελίδα «Έργα» (Operations). Το SoftOne δεν δίνει τις ετικέτες του ACTSTATUS
  // μέσω Web Services — κρατάμε τον κωδικό και η ετικέτα ζει στο `lib/projects.ts`.
  actStatus Int? // ACTSTATUS («Status»)
  trdrSu    Int? // TRDRSU («Προμηθευτής»)
  remarks   String? // REMARKS («Παρατηρήσεις»)
  crdDate   DateTime? // CRDDATE («Δημιουργία»)
  fromDate  DateTime? // FROMDATE («Έναρξη»)
  finalDate DateTime? // FINALDATE («Λήξη»)
  closeDate DateTime? // CLOSEDATE («Κλείσιμο»)

  @@index([name])
  @@index([code])
  @@index([trdr])
  @@index([actStatus])
}

// Υπόλοιπα αποθήκης ανά είδος — καθρέφτης του SoftOne (MTRBALSHEET της τρέχουσας χρήσης).
// Υπόλοιπο = Σ(IMPQTY1 − EXPQTY1) σε όλες τις περιόδους της χρήσης (μαζί η 0 = μεταφορά/απογραφή).
// Επιβεβαιωμένο ζωντανά (atelier, 2026-10-17): το άθροισμα ανά είδος ισούται με το MTRDATA.QTY1
// για 447/447 είδη. Ποσότητες στη ΒΑΣΙΚΗ μονάδα του είδους.
model SoftoneStock {
  mtrl     Int
  whouse   String // SoftOne WHOUSE (ετικέτα: SoftoneLookup kind WHOUSE)
  fiscPrd  Int // χρήση από την οποία βγήκε το υπόλοιπο
  qty      Float
  syncedAt DateTime @default(now())

  @@id([mtrl, whouse])
  @@index([whouse])
}

// Χαρακτηριστικά είδους — ΔΙΚΑ ΜΑΣ δεδομένα (π.χ. «Χρώμα: Λευκό», «Φινίρισμα: Ματ»). Η
// εγκατάσταση δεν έχει ορίσει χαρακτηριστικά στο SoftOne (MTRATTRIBUTE: 0 γραμμές), οπότε
// κρατιούνται εδώ ως ελεύθερα ζεύγη όνομα–τιμή–μονάδα.
model ItemAttribute {
  id        String   @id @default(cuid())
  mtrl      Int
  name      String
  value     String
  unit      String?
  order     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([mtrl, order])
}

// Πολυμέσα είδους/υπηρεσίας (MTRL): φωτογραφίες, βίντεο, πανοράματα 360°. ΔΙΚΑ ΜΑΣ δεδομένα —
// τα αρχεία ζουν στο Bunny CDN, το SoftOne δεν αγγίζεται.
//  • IMAGE: το `publicUrl` είναι το τετράγωνο 1920×1920 WebP που παράγεται από το ΠΡΩΤΟΤΥΠΟ
//    (`originalKey`) με τον μετασχηματισμό `transform` {zoom, x, y, rotate, background}. Η
//    επανεπεξεργασία ξαναπαράγει από το πρωτότυπο — ποτέ από το ήδη συμπιεσμένο αποτέλεσμα.
//  • PANORAMA: WebP στην αρχική αναλογία (equirectangular 2:1), όχι τετράγωνο.
//  • VIDEO: το αρχείο όπως ανέβηκε.
enum ItemMediaKind {
  IMAGE
  VIDEO
  PANORAMA
  DOCUMENT // «Αρχεία» του είδους (PDF) — π.χ. ο οδηγός εγκατάστασης
}

model ItemMedia {
  id              String        @id @default(cuid())
  mtrl            Int // SoftOne MTRL
  kind            ItemMediaKind
  storageKey      String        @unique // Bunny key του αρχείου προβολής
  publicUrl       String
  thumbKey        String?
  thumbUrl        String?
  originalKey     String? // πρωτότυπο (κανονικοποιημένο) — μόνο IMAGE/PANORAMA
  originalUrl     String?
  originalWidth   Int?
  originalHeight  Int?
  originalName    String
  mimeType        String
  size            Int
  width           Int?
  height          Int?
  transform       Json? // IMAGE: { zoom, x, y, rotate, background }
  isPrimary       Boolean       @default(false)
  order           Int           @default(0)
  title           String?
  // Δείγμα εγκατάστασης: χρησιμοποιείται ΜΟΝΟ για τον οδηγό εγκατάστασης — ποτέ σε προσφορές/site/κύρια.
  isInstallSample Boolean       @default(false)
  // VIDEO δείγμα: καρέ που τράβηξε ο browser (Bunny) — [{ key, url, t }] — για το AI και το PDF.
  sampleFrames    Json?
  uploadedById    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([mtrl, kind, order])
}

// Οδηγίες εγκατάστασης: ηχογραφήσεις του χρήστη (ήχος στο Bunny) + απομαγνητοφώνηση (επεξεργάσιμη).
model ItemInstallNote {
  id          String   @id @default(cuid())
  mtrl        Int // SoftOne MTRL
  audioKey    String? // Bunny key (WAV) — null για σημείωση γραμμένη με το χέρι
  audioUrl    String?
  durationSec Float?
  transcript  String   @default("")
  order       Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([mtrl, order])
}

// Ο οδηγός εγκατάστασης που έφτιαξε το AI (δομημένο JSON) + το PDF του στα «Αρχεία» (ItemMedia DOCUMENT).
model ItemInstallGuide {
  id          String   @id @default(cuid())
  mtrl        Int
  content     Json // InstallGuide (lib/install-guide/guide.ts)
  profile     String // προφίλ κατηγορίας (π.χ. tiles, electrical)
  category    String? // όνομα κατηγορίας/ομάδας τη στιγμή της δημιουργίας
  model       String
  provider    String
  pdfMediaId  String? // ItemMedia (DOCUMENT)
  pdfUrl      String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([mtrl, createdAt])
}

// Προϋπολογισμός έργου — ΔΙΚΑ ΜΑΣ δεδομένα (όχι SoftOne): τα υλικά/υπηρεσίες που προβλέπονται για
// ένα έργο, για σύγκριση με τις πραγματικές κινήσεις του SoftOne. Το όνομα και η μονάδα κρατιούνται
// ως στιγμιότυπο, ώστε η γραμμή να διαβάζεται ακόμη κι αν το είδος αλλάξει ή σβηστεί από τον καθρέφτη.
model ProjectBudgetLine {
  id               String   @id @default(cuid())
  prjc             Int // SoftOne PRJC του έργου
  mtrl             Int // SoftOne MTRL (υλικό ή υπηρεσία)
  code             String
  name             String
  isService        Boolean  @default(false)
  unit             String?
  qty              Float
  unitPrice        Float    @default(0)
  notes            String?
  /// Σύμβαση/προσφορά από την οποία μεταφέρθηκε η γραμμή (BOM) — ο επανασυγχρονισμός αντικαθιστά μόνο αυτές.
  sourceContractId String?
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([prjc])
  @@index([mtrl])
  @@index([sourceContractId])
}

// Δραστηριότητες SoftOne — object PRJCSTAGE («Δραστηριότητες») → DB πίνακας PRJCSTAGE.
// Στη γραμμή λέγεται «Κατηγορία δραστηριότητας».
model SoftoneProjectStage {
  id        Int      @id @default(autoincrement())
  prjcStage Int      @unique // SoftOne PRJCSTAGE
  code      String // CODE (σύντμηση)
  name      String // NAME (μπορεί να είναι κενό στο SoftOne → πέφτουμε στο CODE)
  isActive  Boolean  @default(true)
  syncedAt  DateTime @default(now())

  @@index([name])
  @@index([code])
}

// Λίστες χαρακτηρισμού myDATA (EditLists MYDATACLTYPE / MYDATACLCATEGORY). Μητρώα ΑΝΑΦΟΡΑΣ:
// δείχνουν τι σημαίνει ο χαρακτηρισμός που κουβαλά κάθε είδος/υπηρεσία/χρεοπίστωση/έξοδο.
// Η εφαρμογή ΔΕΝ ορίζει χαρακτηρισμό ανά γραμμή — τον ορίζει το μητρώο στο SoftOne.
model SoftoneMyDataClassType {
  id         Int      @id @default(autoincrement())
  sotype     Int // SOTYPE (πλευρά: εσόδων/εξόδων)
  code       Int // MYDATACLTYPE
  myDataCode String? // MYDATACODE (π.χ. «category2_1»)
  sohCode    String? // SOHCODE (ομαδοποίηση myDATA)
  name       String
  isVat      Boolean  @default(false) // ISVAT («Αφορά περιοδική»)
  syncedAt   DateTime @default(now())

  @@unique([sotype, code])
  @@index([name])
}

model SoftoneMyDataClassCategory {
  id         Int      @id @default(autoincrement())
  sotype     Int // SOTYPE
  code       Int // MYDATACLCATEGORY
  myDataCode String?
  sohCode    String?
  name       String
  syncedAt   DateTime @default(now())

  @@unique([sotype, code])
  @@index([name])
}

// Μνήμη αντιστοίχισης γραμμών: (ΑΦΜ εκδότη ή '' για γενικό, κανονικοποιημένο κείμενο) → είδος/υπηρεσία/έξοδο.
// ΠΡΟΣΟΧΗ: το afm είναι NOT NULL με default '' — η Postgres θεωρεί τα NULL διακριτά στο unique index,
// οπότε οι γενικοί κανόνες γράφονται πάντα με afm = '' και ποτέ NULL.
/**
 * ΤΟ ΣΧΗΜΑ ΤΟΥ ΕΠΙΜΕΡΙΣΜΟΥ, ΘΥΜΗΜΕΝΟ.
 * Ο λογιστής σπάει κάθε μήνα ΤΟ ΙΔΙΟ τιμολόγιο με τον ίδιο τρόπο — μετρημένο στα χειρόγραφα
 * των σαρωμένων: «Ιγνατιάδου → 6 κομμάτια», «Δεσποτόπουλος → 4 λογαριασμοί». Το `LineMatchRule`
 * θυμάται ΕΝΑΝ λογαριασμό ανά γραμμή· εδώ θυμόμαστε ΟΛΟΚΛΗΡΟ το σχήμα, ώστε την επόμενη φορά
 * να είναι ένα κλικ αντί για έξι επιλογές και έξι ποσοστά.
 * Κλειδί: ΑΦΜ εκδότη + κανονικοποιημένο κείμενο γραμμής + κόσμος (χρεοπιστώσεις ή απλογραφικά) —
 * το ίδιο κλειδί με τη μνήμη αντιστοίχισης, ώστε οι δύο μνήμες να μη διαφωνούν για το ποια
 * γραμμή είναι «ίδια».
 * `parts` = [{ registryMtrl, accountCode, percent }] σε σειρά. Κρατάμε ΠΟΣΟΣΤΑ και όχι ποσά:
 * το ποσό αλλάζει κάθε μήνα, η αναλογία είναι αυτό που επαναλαμβάνεται.
 */
model AllocationShapeRule {
  id          String    @id @default(cuid())
  afm         String    @default("")
  pattern     String
  kind        String    @default("LINEITEM")
  parts       Json
  timesUsed   Int       @default(0)
  lastUsedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([afm, pattern, kind])
  @@index([pattern])
}

model LineMatchRule {
  id           String   @id @default(cuid())
  afm          String   @default("")
  pattern      String // normalizeLineText του ονόματος της γραμμής
  mtrl         Int? // SoftoneItem.mtrl
  expn         Int? // SoftoneExpense.expn
  lin          Int? // SoftoneLineItem.mtrl (χρεοπίστωση)
  // «Αν το κάνει μια φορά να το θυμάται»: η αναλυτική μαθαίνεται με το ΙΔΙΟ κλειδί (ΑΦΜ + pattern).
  costCntr     Int? // SoftoneCostCenter.costcntr
  prjc         Int? // SoftoneProject.prjc
  prjcStage    Int? // SoftoneProjectStage.prjcStage
  isService    Boolean  @default(false)
  // ΠΟΙΟΣ διάλεξε τον ΣΤΟΧΟ (mtrl/expn/lin): 'manual' = άνθρωπος τον επέλεξε ρητά (ο μόνος
  // δρόμος που γράφει στόχο, `rememberLineMatch`)· NULL = κανόνας πριν από τη στήλη, ΑΓΝΩΣΤΟ. Μια
  // αλλαγή ΜΟΝΟ αναλυτικής δεν γράφει ποτέ στόχο ούτε δημιουργεί κανόνα (`rememberAnalyticsOnly`).
  // Μόνο το 'manual' μετρά ως ανθρώπινη επιβεβαίωση (βλ. `lib/ocr/chart-grounding.ts`).
  targetSource String?
  timesUsed    Int      @default(0)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([afm, pattern])
  @@index([pattern])
}

// Εκδότες που ο χρήστης επέλεξε να μη δημιουργήσει στο SoftOne.
model IgnoredIssuer {
  afm         String   @id
  reason      String?
  createdById String?
  createdAt   DateTime @default(now())
}

// Μνήμη geocoding: μια διεύθυνση ρωτιέται ΜΙΑ φορά τον πάροχο (MapTiler/Nominatim).
//
// Γιατί πίνακας και όχι στήλη JSON: οι ομάδες της ουράς «Νέοι συναλλασσόμενοι» δεν
// έχουν δική τους γραμμή — φτιάχνονται στη μνήμη από τα `OcrDocument` ανά ΑΦΜ. Το
// μόνο «backing data» θα ήταν τα ίδια τα έγγραφα (N γραμμές ανά εκδότη ⇒ N αντίγραφα
// της ίδιας απάντησης). Ένας πίνακας με κλειδί την ΚΑΝΟΝΙΚΟΠΟΙΗΜΕΝΗ διεύθυνση
// μοιράζεται την απάντηση και ανάμεσα σε διαφορετικούς εκδότες της ίδιας διεύθυνσης,
// επιβιώνει restart και — το σημαντικότερο για το quota — κρατά ΚΑΙ τις αστοχίες
// (`found = false`), που αλλιώς θα ξαναρωτιόντουσαν σε κάθε άνοιγμα του panel.
model GeocodeCache {
  id          String   @id @default(cuid())
  // Κανονικοποιημένη διεύθυνση + προαιρετικό country hint — δες `geocodeCacheKey`.
  key         String   @unique
  address     String
  countryHint String?
  // `false` = ο πάροχος δεν αναγνώρισε τη διεύθυνση. Cache-άρεται κι αυτό.
  found       Boolean  @default(false)
  countryCode String?
  country     String?
  city        String?
  zip         String?
  formatted   String?
  lat         Float?
  lng         Float?
  hits        Int      @default(0)
  createdAt   DateTime @default(now())
  usedAt      DateTime @default(now())
  // Πότε ρωτήθηκε ΤΕΛΕΥΤΑΙΑ ο πάροχος. Από εδώ μετριέται το παράθυρο επανελέγχου
  // των αστοχιών (`MISS_RETRY_DAYS`) — το `usedAt` χτυπιέται σε κάθε ανάγνωση.
  checkedAt   DateTime @default(now())

  @@index([usedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// ΣΥΝΔΕΣΗ SOFTONE: ταυτότητα εγκατάστασης, εμπιστοσύνη καθρεφτών, ουρά εργασιών
// ─────────────────────────────────────────────────────────────────────────────

enum SoftoneOutboxStatus {
  PENDING // Περιμένει σύνδεση. Ασφαλές να σταλεί — ΔΕΝ έχει φτάσει ποτέ στο ERP.
  SENT // Έφυγε και επιβεβαιώθηκε.
  NEEDS_REVIEW // Η αίτηση ΙΣΩΣ έφτασε (διακοπή εν πτήσει). ΔΕΝ ξαναστέλνεται μόνη της.
  REJECTED // Το SoftOne την απέρριψε για επιχειρησιακό λόγο — η επανάληψη δεν θα βοηθήσει.
  CANCELLED // Ο χρήστης την ακύρωσε.
}

/// Μια εργασία ΕΓΓΡΑΦΗΣ προς το SoftOne που δεν μπόρεσε να φύγει τώρα.
///
/// Υπάρχει επειδή η σύνδεση με το ERP ΠΕΦΤΕΙ: όταν συνέβη, ο χρήστης έχανε τη δουλειά του και
/// έβλεπε ένα τεχνικό μήνυμα. Τώρα η εργασία μπαίνει σε σειρά και φεύγει μόλις ξανασυνδεθούμε.
///
/// ΤΟ ΚΡΙΣΙΜΟ ΕΙΝΑΙ ΤΟ `NEEDS_REVIEW`. Μια εγγραφή που «ίσως έφτασε» ΔΕΝ ξαναστέλνεται αυτόματα:
/// μια δεύτερη `setData` θα δημιουργούσε ΔΙΠΛΟ συναλλασσόμενο ή διπλό παραστατικό. Αυτόματη
/// επανάληψη γίνεται μόνο όταν ξέρουμε ότι το αίτημα ΔΕΝ εκτελέστηκε ποτέ.
model SoftoneOutbox {
  id String @id @default(cuid())

  /// Η εγκατάσταση για την οποία φτιάχτηκε. Εργασία άλλου tenant ΔΕΝ εκτελείται ποτέ —
  /// τα ids μέσα της (TRDR, MTRL, σειρές) δεν σημαίνουν τίποτα αλλού.
  tenantKey      String
  kind           String // π.χ. «trader.create»
  label          String // Τι βλέπει ο χρήστης στη λίστα αναμονής
  service        String // Η υπηρεσία SoftOne («setData», …)
  payload        Json
  /// Κλειδί ιδεμποτικότητας: δεύτερη ίδια εργασία δεν μπαίνει δεύτερη φορά στην ουρά.
  idempotencyKey String              @unique
  status         SoftoneOutboxStatus @default(PENDING)
  attempts       Int                 @default(0)
  lastError      String?
  result         Json?
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  sentAt         DateTime?

  @@index([status, createdAt])
  @@index([tenantKey])
}

/// Πότε και για ΠΟΙΑ εγκατάσταση κατέβηκε ο κάθε βοηθητικός πίνακας.
///
/// Χωρίς αυτό, μια αλλαγή λογαριασμού SoftOne περνούσε ΑΠΑΡΑΤΗΡΗΤΗ: οι καθρέφτες κρατούσαν
/// TRDR/MTRL της ΠΑΛΙΑΣ εγκατάστασης, η εφαρμογή τα εμφάνιζε σαν έγκυρα, και η επόμενη
/// καταχώριση θα έδειχνε σε ανύπαρκτες — ή, χειρότερα, σε ΑΛΛΕΣ — εγγραφές.
model SoftoneMirrorState {
  table     String   @id // 'traders' | 'items' | 'accounts' | … | 'docs' | 'mydata'
  tenantKey String
  syncedAt  DateTime
  rows      Int      @default(0)

  // ΑΥΞΗΤΙΚΟΣ ΣΥΓΧΡΟΝΙΣΜΟΣ (lib/softone-mirror). Το watermark είναι το μεγαλύτερο UPDDATE που
  // ΕΙΔΑΜΕ από το SoftOne, όπως το έγραψε ο ίδιος ο SQL Server («yyyy-mm-dd hh:mm:ss», χωρίς ζώνη) —
  // ΠΟΤΕ το δικό μας ρολόι: ο SoftOne γράφει UPDDATE σε άλλη ζώνη από το INSDATE.
  watermark    String?
  // Δεύτερο watermark για το INSDATE: στο SoftOne το INSDATE γράφεται συχνά σε ώρα Ελλάδας και το
  // UPDDATE σε UTC (2–3 ώρες διαφορά) — ΔΕΝ συγχωνεύονται σε ένα, κάθε στήλη έχει το δικό της.
  watermarkIns String?
  everyMin     Int? // κάθε πόσα λεπτά (null = η προεπιλογή του πίνακα στο lib/softone-mirror/sync.ts)
  progress     Json? // πρόοδος αρχικής φόρτωσης (backfill) — null όταν δεν τρέχει
  lastRunAt    DateTime? // τελευταία προσπάθεια (επιτυχής ή όχι)
  lastOkAt     DateTime? // τελευταία ΕΠΙΤΥΧΗΣ — με αυτό κρίνεται αν ο καθρέφτης είναι φρέσκος
  lastError    String?
  lastMs       Int?
  lastChanged  Int? // γραμμές που άλλαξαν στον τελευταίο κύκλο
  reconciledAt DateTime? // τελευταία πλήρης σύγκριση (διαγραφές)

  @@index([tenantKey])
}

/// Μίσθωση «ένας τη φορά» για τον συγχρονισμό καθρεφτών. Όχι advisory lock: η εφαρμογή περνά από
/// PgBouncer σε transaction mode, όπου τα session locks δεν κρατιούνται. Μία γραμμή ανά όνομα·
/// όποιος τη βρει ληγμένη την παίρνει με ΕΝΑ ατομικό INSERT … ON CONFLICT … WHERE.
model SoftoneSyncLease {
  name      String   @id
  owner     String
  expiresAt DateTime
}

// ─────────────────────────────────────────────────────────────────────────────
// ΚΑΘΡΕΦΤΗΣ ΠΑΡΑΣΤΑΤΙΚΩΝ SoftOne (μόνο ανάγνωση, lib/softone-mirror). Οι οθόνες διαβάζουν από εδώ·
// το SoftOne ρωτιέται μόνο για ό,τι άλλαξε (UPDDATE). Τα ποσά είναι όπως τα δίνει το SoftOne.
// ─────────────────────────────────────────────────────────────────────────────

/// FINDOC — κεφαλές παραστατικών (όλες οι ενότητες: 1351, 1251, 1253, 1653, 1412, 1413, 1151, …).
model SoftoneFindoc {
  findoc    Int       @id
  fincode   String
  trnDate   DateTime? // TRNDATE (ημέρα, 00:00 UTC — όπως το s1DateOrNull)
  series    String
  sosource  Int
  trdr      Int?
  prjc      Int?
  net       Float     @default(0) // NETAMNT
  vat       Float     @default(0) // VATAMNT
  total     Float     @default(0) // SUMAMNT
  disc1Prc  Float     @default(0)
  disc1Val  Float     @default(0)
  isCancel  Int       @default(0) // ISCANCEL ≠ 0 ⇒ ακυρωμένο/ακυρωτικό
  comments  String?
  comments1 String?
  remarks   String?
  insDate   DateTime? // INSDATE (πλήρης ώρα, όπως τη γράφει ο SoftOne)
  updRaw    String? // UPDDATE αυτούσιο — συγκρίνεται στη νυχτερινή συμφωνία
  syncedAt  DateTime  @default(now())

  @@index([trdr])
  @@index([prjc])
  @@index([sosource, trnDate])
}

/// MTRLINES — γραμμές ειδών/υπηρεσιών. Ο πίνακας ΔΕΝ έχει UPDDATE (GetTable: «Stream read error»):
/// οι γραμμές ενός παραστατικού ξανακατεβαίνουν ΟΛΕΣ όταν αλλάξει το UPDDATE της κεφαλής του.
model SoftoneMtrLine {
  findoc     Int
  mtrlines   Int
  lineNum    Int?
  mtrl       Int?
  qty1       Float   @default(0)
  qty        Float   @default(0)
  mtrUnit    String?
  price      Float   @default(0)
  disc1Prc   Float   @default(0)
  disc2Prc   Float   @default(0)
  disc1Val   Float   @default(0)
  lineVal    Float   @default(0)
  netLineVal Float   @default(0)
  vat        String?
  vatAmnt    Float   @default(0)
  comments   String?
  comments1  String?
  prjc       Int?
  sodtype    Int?
  findocs    Int? // FINDOCS — παραστατικό προέλευσης (μετασχηματισμός)

  @@id([findoc, mtrlines])
  @@index([mtrl])
  @@index([prjc])
  @@index([findocs])
}

/// TRDTLINES — γραμμές εμβασμάτων (ο πελάτης/προμηθευτής είναι στη ΓΡΑΜΜΗ, η κεφαλή έχει την τράπεζα).
model SoftoneTrdLine {
  findoc    Int
  trdtlines Int
  trdr      Int?
  lineNum   Int?
  lineVal   Float @default(0)
  prjc      Int?

  @@id([findoc, trdtlines])
  @@index([trdr])
}

/// MYDATAHEADER — ΜΑΡΚ/QR ανά παραστατικό (SOID = FINDOC). Μόνο ανάγνωση· ΠΟΤΕ εγγραφή προς myDATA.
model SoftoneMyData {
  id         Int     @id // MYDATAHEADER
  soid       Int? // FINDOC — κενό στα παραστατικά που ήρθαν από την ΑΑΔΕ και δεν έχουν αντιστοιχιστεί
  sosource   Int?
  mark       String?
  qrUrl      String?
  invoiceUrl String?
  isCancel   Int     @default(0)
  updRaw     String?
  insRaw     String?
  /// Τα υπόλοιπα πεδία της ΑΑΔΕ (ΑΦΜ εκδότη, σειρά/α.α., ημερομηνία, τύπος, ποσά…) όπως τα δίνει το SoftOne.
  data       Json?

  @@index([soid])
}

/// Γενικός καθρέφτης πινάκων SoftOne που δεν χρειάζονται δικά τους πεδία στη βάση: FINPAYTERMS
/// (λήξεις/δόσεις), EXPANAL/VATANAL (ανάλυση εξόδων/ΦΠΑ) ως παιδιά του FINDOC· TRDEXTRA/TRDPRSN ως
/// παιδιά του TRDR· PRSN (επαφές) και SERIES. `data` = τα πεδία όπως τα δίνει το GetTable.
model SoftoneRecord {
  table    String
  id       String
  parent   Int? // FINDOC ή TRDR του γονέα (για παιδιά)
  updRaw   String?
  insRaw   String?
  data     Json
  syncedAt DateTime @default(now())

  @@id([table, id])
  @@index([table, parent])
}

/// TRDBALSHEET — επίσημα σύνολα χρέωσης/πίστωσης ανά συναλλασσόμενο, χρήση και περίοδο.
model SoftoneTrdBalance {
  id      Int   @id @default(autoincrement())
  trdr    Int
  fiscPrd Int
  period  Int
  debit   Float @default(0)
  credit  Float @default(0)

  @@index([trdr])
}

/// Ημερολόγιο της σύνδεσης: πτώσεις, επανασυνδέσεις και αλλαγές εγκατάστασης.
model SoftoneConnectionEvent {
  id            String   @id @default(cuid())
  at            DateTime @default(now())
  kind          String // 'up' | 'down' | 'tenant_changed'
  tenantKey     String?
  prevTenantKey String?
  detail        Json?

  @@index([at])
}

// ─────────────────────────────────────────────────────────────────────────────
// ΛΟΓΙΣΤΙΚΗ ΑΡΧΙΚΟΠΟΙΗΣΗ — ερωτήματα προς τον λογιστή και θέματα για τον integrator.
// ─────────────────────────────────────────────────────────────────────────────

/// Η ΑΠΑΝΤΗΣΗ του λογιστή σε ένα ερώτημα. Τα ερωτήματα ΔΕΝ αποθηκεύονται εδώ: παράγονται ζωντανά από
/// την κατάσταση της εφαρμογής (κανόνες οικογένειας/είδους χρέωσης, λογαριασμοί που άνοιξαν, εκκρεμότητες).
/// Εδώ ζει μόνο τι είπε ο λογιστής, με κλειδί το ερώτημα και «αποτύπωμα» της πρότασης: αν η πρόταση
/// αλλάξει (π.χ. ο κανόνας δείχνει πλέον σε άλλο έξοδο), η απάντηση παύει να ισχύει και ξαναρωτάμε.
model AccountingAnswer {
  id          String   @id @default(cuid())
  questionKey String   @unique
  /// Η πρόταση που απαντήθηκε — αν η τρέχουσα διαφέρει, η απάντηση είναι παλιά.
  fingerprint String
  /// ACCEPTED · CHANGED (άλλαξε στόχο μέσα από την εφαρμογή) · NEEDS_ERP (ζήτησε ενέργεια στο SoftOne)
  status      String
  comment     String?  @db.Text
  answeredBy  String?
  answeredAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Θέμα για τον integrator — ό,τι η εφαρμογή ΔΕΝ μπορεί να κάνει μέσω web services. Δημιουργείται
/// αυτόματα όταν ο λογιστής ζητά κάτι τέτοιο, ή χειροκίνητα. Οι αυτόματοι έλεγχοι της σελίδας
/// (π.χ. χρεοπιστώσεις χωρίς χαρακτηρισμό myDATA) υπολογίζονται ζωντανά και δεν αποθηκεύονται.
model IntegratorItem {
  id          String    @id @default(cuid())
  title       String
  detail      String    @db.Text
  /// high · mid · low
  severity    String    @default("mid")
  /// OPEN · DONE
  status      String    @default("OPEN")
  /// accountant · manual
  source      String    @default("accountant")
  questionKey String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?

  @@index([status])
}

/// Καθρέφτης ΠΑΓΙΩΝ του SoftOne (object ASSET → MTRL με SODTYPE 54). Μόνο ανάγνωση από τον
/// συγχρονισμό· νέα πάγια ανοίγονται από την εφαρμογή (setData ASSET) και γράφονται εδώ αμέσως.
model SoftoneAsset {
  id          Int      @id @default(autoincrement())
  mtrl        Int      @unique // SoftOne MTRL (SODTYPE 54)
  code        String
  name        String
  vat         String? // VAT (κατηγορία ΦΠΑ)
  mtrAcn      Int? // MTRACN — λογιστική κατηγορία παγίου (ASSETGL)
  mtrCategory Int? // MTRCATEGORY — εμπορική κατηγορία παγίου (ASSCATEGORY)
  acnmsk      String? // ACNMSK — λογαριασμός αγορών (π.χ. 14.03.00)
  isActive    Boolean  @default(true)
  syncedAt    DateTime @default(now())

  @@index([name])
  @@index([code])
}

/// Ιστορικό ελέγχων ξένου ΑΦΜ (VIES / HMRC / Brønnøysund / UID) — cache 30 ημερών ΚΑΙ αποδεικτικό
/// ελέγχου (αριθμός ελέγχου της αρχής). Βλ. lib/foreign-vat-check.ts.
model VatCheck {
  id                 String   @id @default(cuid())
  vat                String // κανονική μορφή: πρόθεμα + σώμα (IT01808880270, CHE116281710, NO923609016)
  countryCode        String
  valid              Boolean?
  name               String?
  address            String?
  provider           String?
  source             String?
  consultationNumber String?
  requester          String?
  match              Json?
  error              String?
  message            String?
  createdById        String?
  createdAt          DateTime @default(now())

  @@index([vat, createdAt])
}

// ── Συνεργάτες (Operations) ─────────────────────────────────────────────────────────────────────
// Τοπικό μητρώο (ΟΧΙ καθρέφτης SoftOne): εταιρίες ή φυσικά πρόσωπα που συνεργάζονται με την εταιρία
// (μηχανικοί, εργολάβοι, σχεδιαστές…). Μια εταιρία έχει πολλά πρόσωπα επικοινωνίας με ιδιότητα.
// Ο συνεργάτης συσχετίζεται με πολλούς πελάτες (SoftoneTrader.trdr) και με έργα (SoftoneProject.prjc)
// αυτών των πελατών.
enum PartnerType {
  COMPANY
  PERSON
}

model Partner {
  id        String      @id @default(cuid())
  type      PartnerType @default(COMPANY)
  // Εταιρία: name = επωνυμία, tradeName = διακριτικός τίτλος.
  // Πρόσωπο: firstName + lastName· το name κρατά το «Επώνυμο Όνομα» για ταξινόμηση/αναζήτηση.
  name      String
  tradeName String?
  firstName String?
  lastName  String?
  specialty String? // ιδιότητα / ειδικότητα (π.χ. «Αρχιτέκτονας», «Ηλεκτρολόγος»)
  afm       String?
  doy       String?
  country   String?     @default("GR")
  address   String?
  city      String?
  zip       String?
  phone     String?
  mobile    String?
  email     String?
  website   String?
  notes     String?
  isActive  Boolean     @default(true)
  userId    String?     @unique // φυσικό πρόσωπο: πρόσβαση στο portal ο ίδιος (ρόλος COLLABORATOR)
  user      User?       @relation("PartnerSelfUser", fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  contacts  PartnerContact[]
  customers PartnerCustomer[]
  projects  PartnerProject[]

  @@index([name])
  @@index([afm])
  @@index([type])
}

model PartnerContact {
  id        String   @id @default(cuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name      String
  role      String? // ιδιότητα στην εταιρία (π.χ. «Διευθυντής έργου»)
  phone     String?
  mobile    String?
  email     String?
  notes     String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  userId    String?  @unique // πρόσβαση στο portal (ρόλος COLLABORATOR)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId])
}

model PartnerCustomer {
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  trdr      Int // SoftOne TRDR του πελάτη
  notes     String?
  createdAt DateTime @default(now())

  @@id([partnerId, trdr])
  @@index([trdr])
}

model PartnerProject {
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  prjc      Int // SoftOne PRJC του έργου
  role      String? // ρόλος του συνεργάτη στο έργο
  notes     String?
  createdAt DateTime @default(now())

  @@id([partnerId, prjc])
  @@index([prjc])
}

// Εμπορικές κατηγορίες (MTRCATEGORY) και ομάδες (MTRGROUP) ειδών/υπηρεσιών — καθρέφτης SoftOne.
// Η αρίθμηση είναι ΑΝΑ SODTYPE (51 είδη, 52 υπηρεσίες): η ομάδα 1 των ειδών και η ομάδα 1 των
// υπηρεσιών είναι ΔΙΑΦΟΡΕΤΙΚΕΣ εγγραφές — γι' αυτό το κλειδί είναι (kind, sodtype, code).
// Το GetTable ΚΡΥΒΕΙ τις ανενεργές: όποια λείπει στον συγχρονισμό σημειώνεται ανενεργή.
// Εγγραφή στο SoftOne: ΜΟΝΟ κατηγορίες (ITECATEGORY/SRVCATEGORY). Οι ομάδες (ITEGROUP/SRVGROUP)
// είναι λίστα-αντικείμενο που στο setData έσβησε τη γραμμή του KEY (atelier, 2026-10-17) — read-only.
model SoftoneClassification {
  id        Int      @id @default(autoincrement())
  kind      String // CATEGORY | GROUP
  sodtype   Int // 51 είδη · 52 υπηρεσίες
  code      Int // MTRCATEGORY / MTRGROUP (αριθμητικό κλειδί)
  shortCode String? // CODE («Σύντμηση»)
  name      String
  isActive  Boolean  @default(true)
  syncedAt  DateTime @default(now())

  @@unique([kind, sodtype, code])
  @@index([kind, sodtype])
}

// Μονάδες μέτρησης — καθρέφτης SoftOne MTRUNIT (EditMaster, εγγραφή ανά μονάδα).
// Επιβεβαιωμένο ζωντανά (atelier, 2026-10-17): setData με ΡΗΤΟ αριθμό για νέα, μερική ενημέρωση,
// οι υπόλοιπες μονάδες μένουν ανέπαφες. Το GetTable ΚΡΥΒΕΙ τις ανενεργές (ανάγνωση με getData).
model SoftoneUnit {
  id          Int        @id @default(autoincrement())
  code        Int        @unique // MTRUNIT
  shortcut    String // SHORTCUT («Σύντμηση», έως 5)
  name        String // NAME («Περιγραφή»)
  interCode   String? // INTERCODE («Διεθνής κωδικός», π.χ. m², έως 5)
  decimals    Int        @default(2) // QDECIMALS
  sodim       Int        @default(1) // SODIM («Διάσταση») — δεν αλλάζει από την εφαρμογή
  sodiv       Float      @default(1) // SODIV («Διαιρέτης διάστασης»)
  myDataCode  Int? // MYDATACODE (μονάδα myDATA της ΑΑΔΕ)
  isActive    Boolean    @default(true)
  syncedAt    DateTime   @default(now())
  // Εικονίδιο (μόνο στην εφαρμογή — το MTRUNIT δεν έχει πεδίο εικόνας): ανέβασμα ή δημιουργία με AI,
  // αρχείο στη βιβλιοθήκη πολυμέσων (Bunny). Ο συγχρονισμός από SoftOne δεν το αγγίζει.
  iconMediaId String?
  iconMedia   MediaFile? @relation(fields: [iconMediaId], references: [id], onDelete: SetNull)

  @@index([iconMediaId])
}

// ── Κοινό container (Operations) ────────────────────────────────────────────────────────────────
// Ένα προϊόν, ένα container που γεμίζει με παραγγελίες ΠΟΛΛΩΝ πελατών (από ½ παλέτα). Όσο γεμίζει,
// η τιμή πέφτει για ΟΛΟΥΣ: κλιμάκια σε παλέτες → PRICEW01…05 του είδους στο SoftOne.
enum ContainerOfferStatus {
  DRAFT
  SCHEDULED // δημοσιεύεται αυτόματα στο `publishAt` (cron)
  OPEN
  CLOSED
  CANCELLED
}

model ContainerOffer {
  id              String               @id @default(cuid())
  title           String? // π.χ. «Travertino & Πλακάκια — Container Νοεμβρίου»
  status          ContainerOfferStatus @default(DRAFT)
  // Χωρητικότητα σε ΠΑΛΕΤΕΣ — κοινή για όλα τα προϊόντα (το καθένα έχει δικά του τ.μ./παλέτα).
  capacityPallets Float
  minOrder        Float                @default(0.5) // ελάχιστη παραγγελία σε παλέτες
  closesAt        DateTime? // προθεσμία συμμετοχής
  publishAt       DateTime? // πότε δημοσιεύεται (στέλνονται τα email)
  publishedAt     DateTime?
  snapshotUrl     String? // 3D εικόνα για τα email (Bunny)
  notifiedLevel   Int? // μέχρι ποιο κλιμάκιο έχουν ενημερωθεί οι παραλήπτες για πτώση τιμής
  notes           String?
  createdById     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  items        ContainerOfferItem[]
  tiers        ContainerOfferTier[]
  reservations ContainerReservation[]
  recipients   OfferRecipient[]
  emails       OfferEmail[]

  @@index([status])
}

// Προϊόν της δυναμικής προσφοράς: δικά του τ.μ./παλέτα και δικές του τιμές ανά κλιμάκιο
// (prices[level-1] → PRICEW0{level} του είδους στο SoftOne). Τα κλιμάκια/γέμισμα είναι ΚΟΙΝΑ.
model ContainerOfferItem {
  id           String                 @id @default(cuid())
  offerId      String
  offer        ContainerOffer         @relation(fields: [offerId], references: [id], onDelete: Cascade)
  mtrl         Int // SoftOne MTRL
  code         String // στιγμιότυπο κωδικού/περιγραφής
  name         String
  baseUnit     String? // σύντμηση βασικής μονάδας (π.χ. Μετ²)
  sqmPerPallet Float // βασικές μονάδες ανά παλέτα
  order        Int                    @default(0)
  prices       Float[] // μία τιμή ανά κλιμάκιο, PRICEW01 (η μεγαλύτερη) … PRICEW08
  createdAt    DateTime               @default(now())
  reservations ContainerReservation[]

  @@unique([offerId, mtrl])
  @@index([mtrl])
}

// Κοινό σημείο πτώσης τιμής: από `fromPallets` (γέμισμα ΟΛΟΥ του container) ισχύει η PRICEW0{level}
// κάθε προϊόντος (η τιμή είναι στο ContainerOfferItem.prices).
model ContainerOfferTier {
  id          String         @id @default(cuid())
  offerId     String
  offer       ContainerOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  level       Int // 1…8 → PRICEW01…PRICEW08
  fromPallets Float

  @@unique([offerId, level])
}

model ContainerReservation {
  id           String             @id @default(cuid())
  offerId      String
  offer        ContainerOffer     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  // Ποιο προϊόν της προσφοράς (οι παλέτες μετράνε στο ΚΟΙΝΟ γέμισμα).
  offerItemId  String
  offerItem    ContainerOfferItem @relation(fields: [offerItemId], references: [id], onDelete: Cascade)
  // Ποιος κλείνει: πελάτης SoftOne (trdr) Ή συνεργάτης (partnerId) — ακριβώς ένα από τα δύο.
  trdr         Int? // SoftOne TRDR του πελάτη
  partnerId    String? // Partner.id
  pallets      Float // πολλαπλάσιο του ½
  // PENDING (αίτημα από το portal, ΔΕΝ μετράει στο γέμισμα) → ACTIVE (εγκρίθηκε) | REJECTED · ACTIVE → CANCELLED
  status       String             @default("ACTIVE")
  notes        String?
  createdById  String? // ο χρήστης που την καταχώρισε (διαχειριστής ή ο ίδιος ο πελάτης από το portal)
  decidedById  String? // ποιος ενέκρινε/απέρριψε
  decidedAt    DateTime?
  decisionNote String? // π.χ. λόγος απόρριψης
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  payments     VivaPayment[] // αιτήματα πληρωμής Viva (το ενεργό = το πιο πρόσφατο μη ακυρωμένο)

  @@index([offerId])
  @@index([offerItemId])
  @@index([trdr])
  @@index([partnerId])
}

// ── Πληρωμές Viva (Smart Checkout) ────────────────────────────────────────────────────────────
// Ένα ΑΙΤΗΜΑ ΠΛΗΡΩΜΗΣ ανά εγκεκριμένη κράτηση: προσωπικός σύνδεσμος /pay/viva/<token> που δεν λήγει·
// κάθε άνοιγμα φτιάχνει (ή ξαναχρησιμοποιεί) ένα payment order του Viva (VivaOrder, λήγει σε λίγη ώρα).
// Ποσό = παλέτες × μονάδες/παλέτα × τιμή κλιμακίου (καθαρή) + ΦΠΑ — στιγμιότυπο τη στιγμή της έγκρισης.
model VivaPayment {
  id            String               @id @default(cuid())
  reservationId String
  reservation   ContainerReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  token         String               @unique // ο προσωπικός σύνδεσμος (μη μαντέψιμος)
  env           String // demo | production — σε ποιο περιβάλλον Viva ανήκει
  // PENDING (στάλθηκε, αναμένεται) → PAID · PENDING → CANCELLED · PAID → REFUNDED (όλο το ποσό επιστράφηκε)
  status        String               @default("PENDING")
  pallets       Float
  quantity      Float // βασικές μονάδες (π.χ. τ.μ.)
  unit          String?
  level         Int // κλιμάκιο (PRICEW0x) της τιμής
  unitPrice     Float // καθαρή τιμή μονάδας
  vatRate       Float // %
  netCents      Int
  vatCents      Int
  amountCents   Int // μικτό ποσό που ζητείται
  paidCents     Int?
  refundedCents Int                  @default(0)
  transactionId String? // η συναλλαγή Viva που την εξόφλησε
  paidAt        DateTime?
  email         String? // πού στάλθηκε
  emailSentAt   DateTime?
  emailError    String?
  lastError     String?
  createdById   String?
  cancelledAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  orders  VivaOrder[]
  refunds VivaRefund[]

  @@index([reservationId])
  @@index([status])
}

// Payment order του Viva (orderCode → checkout). OPEN → PAID | FAILED | EXPIRED | CANCELLED.
model VivaOrder {
  id            String      @id @default(cuid())
  paymentId     String
  payment       VivaPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderCode     String      @unique
  amountCents   Int
  status        String      @default("OPEN")
  transactionId String?
  expiresAt     DateTime
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([paymentId])
}

// Επιστροφή χρημάτων (Viva Cancel Transaction με ποσό). `key` = ιδεμποτέντ: μία επιστροφή διαφοράς ανά πληρωμή.
model VivaRefund {
  id            String      @id @default(cuid())
  paymentId     String
  payment       VivaPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  key           String      @unique // <paymentId>-<kind>
  kind          String // PRICE_DIFF (πτώση τιμής στο κλείσιμο) | FULL (ακύρωση κράτησης)
  amountCents   Int
  status        String      @default("PENDING") // PENDING | DONE | FAILED
  transactionId String?
  error         String?
  createdById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([paymentId])
}

// Inbox των webhooks του Viva — ιδεμποτέντ ανά (τύπος, συναλλαγή): οι επαναλήψεις δεν ξαναεφαρμόζονται.
model VivaWebhookEvent {
  id            String    @id @default(cuid())
  dedupeKey     String    @unique // <EventTypeId>:<TransactionId>
  eventTypeId   Int
  messageId     String?
  orderCode     String?
  transactionId String?
  payload       Json
  status        String    @default("RECEIVED") // RECEIVED | PROCESSED | IGNORED | ERROR
  result        String?
  error         String?
  attempts      Int       @default(1)
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([orderCode])
}

// Παραλήπτες της δυναμικής προσφοράς: πελάτες (SoftOne) και συνεργάτες (τοπικό μητρώο).
model OfferRecipient {
  id        String         @id @default(cuid())
  offerId   String
  offer     ContainerOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  kind      String // CUSTOMER | PARTNER
  refId     String // TRDR ή Partner.id
  name      String
  email     String?
  createdAt DateTime       @default(now())
  emails    OfferEmail[]

  @@unique([offerId, kind, refId])
  @@index([offerId])
}

// Ημερολόγιο αποστολών: ΜΙΑ αποστολή ανά παραλήπτη/τύπο/κλιμάκιο (ιδεμποτέντ — καμία διπλή).
model OfferEmail {
  id          String         @id @default(cuid())
  offerId     String
  offer       ContainerOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   OfferRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  kind        String // PUBLISH | PRICE_DROP
  level       Int            @default(0) // κλιμάκιο (για PRICE_DROP)
  status      String // SENT | FAILED
  error       String?
  sentAt      DateTime       @default(now())

  @@unique([recipientId, kind, level])
  @@index([offerId])
}

// Πρόσωπα επικοινωνίας ΠΕΛΑΤΗ (SoftOne TRDR) — τοπικά. Κάθε πρόσωπο μπορεί να έχει πρόσβαση στο
// portal (χρήστης με ρόλο CUSTOMER, δεμένος με τον πελάτη μέσω User.customerTrdr).
model CustomerContact {
  id          String   @id @default(cuid())
  trdr        Int
  name        String
  role        String? // ιδιότητα (π.χ. «Υπεύθυνος αγορών»)
  phone       String?
  mobile      String?
  email       String?
  notes       String?
  isPrimary   Boolean  @default(false)
  softonePrsn Int? // το «Πρόσωπο» στο SoftOne (PRSNOUT/PRSN), όταν η επαφή δημιουργήθηκε/συνδέθηκε εκεί
  sortOrder   Int      @default(0)
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([trdr])
}

// Τοποθεσίες πελάτη (πύλη): σπίτια, καταστήματα, εργοτάξια. Δικά μας δεδομένα — όχι SoftOne.
// Κάθε αίτημα/προσφορά δένει με μία, ώστε ο τεχνικός φάκελος να μαζεύεται ανά εγκατάσταση.
model CustomerSite {
  id          String     @id @default(cuid())
  trdr        Int
  label       String // «Σπίτι Κηφισιά», «Κατάστημα Γλυφάδας»
  address     String?
  zip         String?
  district    String?
  city        String?
  floor       String? // όροφος / διαμέρισμα
  notes       String? // πρόσβαση, ώρες, ασανσέρ, στάθμευση
  lat         Float?
  lng         Float?
  isDefault   Boolean    @default(false)
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  contracts   Contract[]

  @@index([trdr])
}

// Αιτήματα αλλαγής εταιρικών στοιχείων από την πύλη. Ο πελάτης ΔΕΝ γράφει στο SoftOne:
// το προσωπικό ελέγχει, περνά την αλλαγή στο SoftOne με το χέρι και κλείνει το αίτημα.
model CustomerChangeRequest {
  id          String    @id @default(cuid())
  trdr        Int
  userId      String?
  userEmail   String?
  /// [{ field, label, from, to }]
  changes     Json
  note        String?
  /// PENDING · APPLIED · REJECTED
  status      String    @default("PENDING")
  reply       String?
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([trdr, status])
  @@index([status, createdAt])
}

// Κερδοφορία έργου — ΣΤΙΓΜΙΟΤΥΠΟ του υπολογισμού από τα παραστατικά του SoftOne (μόνο ανάγνωση).
// Υπολογίζονται ΟΛΑ τα έργα μαζί με λίγα GetTable (βλ. `lib/project-profit/`), ώστε η λίστα να
// ταξινομείται χωρίς ζωντανή κλήση ανά γραμμή. Τα ποσά είναι καθαρά (χωρίς ΦΠΑ), εκτός από τα
// εισπραγμένα/ανοιχτό υπόλοιπο, που είναι μικτά — όπως πληρώνει ο πελάτης.
model ProjectFinancials {
  id         Int      @id @default(autoincrement())
  prjc       Int      @unique
  revenue    Float // καθαρά έσοδα (τιμολόγια − πιστωτικά)
  collected  Float // εισπράξεις (εμβάσματα πελατών με το έργο)
  openAmount Float // μικτά τιμολογηθέντα − εισπράξεις
  costs      Float // άμεσο κόστος (αγορές/υπηρεσίες/εκτίμηση αποθέματος)
  overhead   Float // επιμερισμός γενικών εξόδων
  netProfit  Float
  marginPct  Float? // null όταν δεν υπάρχουν έσοδα
  paid       Float // πληρωμές προμηθευτών με το έργο
  issues     Int      @default(0) // πόσα «Δεδομένα που λείπουν»
  data       Json // πλήρης ανάλυση (ProjectProfit)
  computedAt DateTime @default(now())
}

// Ποσοστό ΓΕΝΙΚΩΝ ΕΞΟΔΩΝ ανά περίοδο, ως % επί του άμεσου κόστους. ΚΟΙΝΗ σύμβαση με το
// «Πραγματικό κόστος» (landed cost): `category` null = γενικό ποσοστό της περιόδου· με τιμή =
// παράκαμψη για μια κατηγορία κόστους. Κλειδιά κατηγορίας: `cost:materials` · `cost:services` ·
// `cost:other` · `cost:stock` (κόστος έργων) — άλλες ενότητες μπορούν να ορίσουν δικά τους με
// δικό τους πρόθεμα (π.χ. `mtrcategory:<n>`). Επίλυση: `lib/overheads-resolve.ts`.
model OverheadRate {
  id          String    @id @default(cuid())
  validFrom   DateTime  @db.Date
  validTo     DateTime? @db.Date // null = ανοιχτό
  percent     Float
  category    String?
  note        String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([validFrom])
  @@index([category])
}

// Αίτημα παραγγελίας πελάτη από το B2B portal. ΔΕΝ γράφεται στο SoftOne: το προσωπικό το ελέγχει
// και (προς το παρόν χειροκίνητα) καταχωρίζει την παραγγελία πώλησης (σειρά 7021). Ο πελάτης
// ορίζεται ΠΑΝΤΑ από τη σύνδεση (User.customerTrdr), ποτέ από τη φόρμα.
model OrderRequest {
  id              String             @id @default(cuid())
  number          Int                @unique @default(autoincrement()) // «ΑΠ-000123» στο UI
  trdr            Int // SoftOne TRDR του πελάτη
  createdById     String // ο χρήστης του portal
  prjc            Int? // προαιρετικά: για ποιο έργο του πελάτη
  // SUBMITTED → IN_REVIEW → CONFIRMED | REJECTED · SUBMITTED → CANCELLED (από τον πελάτη)
  status          String             @default("SUBMITTED")
  customerRef     String? // αριθμός/αναφορά του πελάτη
  deliveryAddress String?
  deliveryDate    DateTime?
  notes           String?
  staffNote       String? // απάντηση/σχόλιο προς τον πελάτη
  softoneFincode  String? // όταν καταχωρίστηκε στο SoftOne (π.χ. «ΠΑΡ0000057»)
  decidedById     String?
  decidedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  lines           OrderRequestLine[]

  @@index([trdr])
  @@index([status])
}

model OrderRequestLine {
  id        String       @id @default(cuid())
  requestId String
  request   OrderRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  mtrl      Int
  code      String?
  name      String // στιγμιότυπο ονομασίας τη στιγμή του αιτήματος
  unit      String?
  qty       Float
  note      String?
  sortOrder Int          @default(0)

  @@index([requestId])
}

// ── Ραντεβού στο atelier, newsletter & leads (δημόσιο website) ─────────────────────────────────
// Κάθε ραντεβού και κάθε επιβεβαιωμένη εγγραφή στο newsletter δημιουργεί/ενημερώνει ένα Lead (ένα
// ανά email). Το Lead γράφεται ΚΑΙ στο SoftOne ως υποψήφιος πελάτης (CUSTOMER, ISPROSP=1) μόνο όταν
// είναι ανοιχτή η ρύθμιση `leads.softoneEnabled` — βλ. lib/leads.ts.
model Lead {
  id              String                @id @default(cuid())
  email           String                @unique // πάντα πεζά
  name            String?
  company         String?
  phone           String?
  profession      String?
  sources         String[] // «appointment», «newsletter»
  notes           String?
  // SoftOne: PENDING (περιμένει) · DISABLED (η ρύθμιση κλειστή) · CREATED · LINKED (υπήρχε ήδη) · FAILED
  softoneStatus   String                @default("PENDING")
  softoneTrdr     Int?
  softoneCode     String?
  softoneError    String?
  softoneSyncedAt DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  appointments    Appointment[]
  subscriber      NewsletterSubscriber?

  @@index([softoneStatus])
  @@index([createdAt])
}

model Appointment {
  id                String    @id @default(cuid())
  number            Int       @unique @default(autoincrement()) // «ΡΝΤ-000123» στο UI
  // website = από τη δημόσια φόρμα (με lead) · staff = προγραμματισμένο από το προσωπικό
  source            String    @default("website")
  leadId            String?
  lead              Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // Με ποιον (ραντεβού προσωπικού): συναλλασσόμενος SoftOne, επαφή του, συνεργάτης ή επαφή συνεργάτη
  trdr              Int?
  customerContactId String?
  partnerId         String?
  partnerContactId  String?
  createdById       String?
  // Υπεύθυνος από το προσωπικό· αν είναι συνδεδεμένος με χρήστη SoftOne, το ραντεβού γράφεται ως Ενέργεια (SOACTION)
  assignedToId      String?
  softoneAction     Int?
  softoneActionCode String?
  softoneSync       String? // SYNCED · FAILED · null = δεν αφορά/δεν στάλθηκε
  softoneError      String?
  // Πού: atelier (στην εταιρία) · customer (στον πελάτη) — ορίζει και τη σειρά «Ραντεβού» στο SoftOne
  place             String    @default("atelier")
  location          String? // διεύθυνση όταν δεν είναι στο atelier
  icsSequence       Int       @default(0) // αυξάνει σε κάθε αλλαγή, ώστε τα ημερολόγια να ενημερώνουν το ίδιο γεγονός
  startsAt          DateTime
  endsAt            DateTime
  // PENDING (αίτημα) → CONFIRMED → COMPLETED | NO_SHOW · PENDING/CONFIRMED → CANCELLED
  status            String    @default("PENDING")
  name              String
  email             String?
  phone             String?
  company           String?
  topic             String?
  message           String?
  staffNote         String? // σημείωση/μήνυμα προς τον επισκέπτη
  rescheduledFrom   DateTime?
  decidedById       String?
  decidedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([startsAt])
  @@index([status])
  @@index([leadId])
  @@index([trdr])
  @@index([assignedToId])
}

// Κλειστές μέρες/ώρες (αργίες, εκθέσεις, άδειες). Ολοήμερο = από 00:00 έως 00:00 της επόμενης.
model AppointmentBlock {
  id          String   @id @default(cuid())
  startsAt    DateTime
  endsAt      DateTime
  allDay      Boolean  @default(false)
  reason      String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([startsAt])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  leadId         String?   @unique
  lead           Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  // PENDING (περιμένει επιβεβαίωση από το email) → CONFIRMED → UNSUBSCRIBED
  status         String    @default("PENDING")
  token          String    @unique // επιβεβαίωση & διαγραφή
  source         String? // footer · modal · appointment
  consentAt      DateTime  @default(now())
  confirmSentAt  DateTime?
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
}

// ── Air Jordan (βοηθός AI για ADMIN / SUPER_ADMIN) ────────────────────────────────────────────────
// Μνήμη RAG σε pgvector: η «γνώση» (AssistantChunk) χτίζεται από τα δεδομένα της εφαρμογής (καθρέφτες
// SoftOne, έργα, συναλλασσόμενοι, είδη, wiki, γλωσσάρι SoftOne) και η «εμπειρία» (AssistantMemory)
// από ό,τι μαθαίνει στις συνομιλίες (συνώνυμα, διορθώσεις, επιβεβαιωμένες απαντήσεις).
// Ο βοηθός ΜΟΝΟ διαβάζει — γράφει μόνο σε αυτούς τους πίνακες.

model AssistantChunk {
  id          String                       @id @default(cuid())
  /// project | trader | item | service | lookup | classification | unit | partner | offer | appointment | lead | order_request | wiki | glossary
  source      String
  /// Μοναδικό κλειδί πηγής, π.χ. «project:123», «trader:45», «wiki:operations/projects».
  refKey      String                       @unique
  title       String
  body        String
  /// Σύνδεσμος στην εφαρμογή (π.χ. /admin/projects/123).
  url         String?
  meta        Json?
  /// Κείμενο αναζήτησης: πεζά, χωρίς τόνους + greeklish μεταγραφή (pg_trgm).
  searchText  String
  contentHash String
  embedding   Unsupported("vector(1536)")?
  updatedAt   DateTime                     @updatedAt
  createdAt   DateTime                     @default(now())
  // + HNSW (vector_cosine_ops) στο embedding — μόνο στο migration, το Prisma δεν εκφράζει HNSW.

  @@index([source])
  @@index([searchText(ops: raw("gin_trgm_ops"))], map: "AssistantChunk_searchText_trgm_idx", type: Gin)
}

model AssistantMemory {
  id         String                       @id @default(cuid())
  /// alias (όρος → οντότητα) | fact (γεγονός) | preference (προτίμηση απάντησης) | answer (επιβεβαιωμένη απάντηση)
  kind       String
  text       String
  /// Προαιρετικά η οντότητα που αφορά (π.χ. «trader:45»).
  refKey     String?
  searchText String
  embedding  Unsupported("vector(1536)")?
  userId     String?
  messageId  String?
  uses       Int                          @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt
  // + HNSW (vector_cosine_ops) στο embedding — μόνο στο migration.

  @@index([kind])
  @@index([userId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], map: "AssistantMemory_searchText_trgm_idx", type: Gin)
}

model AssistantConversation {
  id        String             @id @default(cuid())
  userId    String
  title     String
  messages  AssistantMessage[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId, updatedAt])
}

model AssistantMessage {
  id             String                @id @default(cuid())
  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// user | assistant
  role           String
  content        String
  /// Πηγές της απάντησης: [{ refKey, label, url }]
  citations      Json?
  /// Κλήσεις εργαλείων (για έλεγχο): [{ name, args, ms, ok }]
  toolCalls      Json?
  model          String?
  costUsd        Float?
  /// 1 = σωστή (θα τη θυμάται), -1 = λάθος
  feedback       Int?
  createdAt      DateTime              @default(now())

  @@index([conversationId, createdAt])
}

// Τοποθεσία ΕΡΓΟΥ (εργοτάξιο). Το SoftOne δεν έχει πεδίο συντεταγμένων στο PRJC (μόνο διεύθυνση οικοδομής
// στο PRJCBLD, αχρησιμοποίητο, και ελεύθερα πεδία PRJEXTRA) — η ακριβής θέση ζει εδώ.
model ProjectSite {
  id          String   @id @default(cuid())
  prjc        Int      @unique // SoftOne PRJC
  address     String? // οδός & αριθμός
  zip         String?
  district    String? // περιοχή
  city        String?
  formatted   String? // πλήρης διεύθυνση όπως τη δίνει ο geocoder
  lat         Float
  lng         Float
  /// geocode (από τη διεύθυνση) · marker (μετακίνηση στον χάρτη) · manual
  source      String   @default("geocode")
  /// exact (αριθμός οδού) · street · area — η ακρίβεια του geocoder πριν από τυχόν μετακίνηση
  precision   String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// Αρχεία πελατών/προμηθευτών (TRDR) και έργων (PRJC) — AutoCAD, PDF, Excel, Word στο Bunny.
// ΧΩΡΙΣΤΟΙ πίνακες (όχι στήλες στο SoftoneTrader/SoftoneProject): ο resync σβήνει και ξαναγράφει
// τους καθρέφτες, ο φάκελος όμως πρέπει να μείνει ίδιος. Η διαδρομή γράφεται ΜΙΑ φορά, στη
// δημιουργία, και δεν αλλάζει με μετονομασία — π.χ. `traders/30-0012-papadopoulos-ae`.
// ============================================================
model EntityFolder {
  id         String       @id @default(cuid())
  /// TRADER (TRDR — πελάτης ή προμηθευτής, κοινό δέντρο) · PROJECT (PRJC)
  entityType String
  entityId   Int // TRDR ή PRJC
  basePath   String       @unique // διαδρομή στο Bunny, χωρίς / στην αρχή/τέλος
  /// υποφάκελοι (ονόματα όπως τα βλέπει ο χρήστης) — και οι άδειοι
  subfolders String[]     @default([])
  createdAt  DateTime     @default(now())
  files      EntityFile[]

  @@unique([entityType, entityId])
}

model EntityFile {
  id           String            @id @default(cuid())
  folderId     String
  folder       EntityFolder      @relation(fields: [folderId], references: [id], onDelete: Cascade)
  subfolder    String            @default("") // "" = ρίζα
  name         String // όνομα που βλέπει ο χρήστης (μετονομάζεται)
  originalName String
  ext          String // dwg · dxf · dwf · dwfx · pdf · xls · xlsx · csv · doc · docx
  mimeType     String // από τον πίνακα τύπων — ΟΧΙ ό,τι δήλωσε ο browser
  size         Int
  storageKey   String            @unique // ιδιωτικό κλειδί στο Bunny — δεν φεύγει ποτέ προς τον browser
  notes        String?
  uploadedById String?
  uploadedBy   String? // όνομα/email τη στιγμή του ανεβάσματος (για τη λίστα)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  tasks        ProjectTaskFile[]

  @@index([folderId, subfolder])
}

// ── Εμπορικές κατηγορίες συναλλασσομένων (SoftOne TRDBUSINESS) σε ιεραρχία με SOHCODE ─────────────
// Ορισμός δέντρου και κανόνες ΚΑΔ: `lib/trader-classes.ts` (πηγή αλήθειας)· εδώ ο καθρέφτης για την εφαρμογή
// και το κλειδί του SoftOne όταν δημιουργηθεί. Ένα δέντρο ανά SODTYPE (10 πελάτες · 20 προμηθευτές)·
// στην καρτέλα γράφεται μόνο φύλλο (κόμβος χωρίς παιδιά). ΔΕΝ αγγίζουμε TRDCATEGORY / TRDGROUP.
model TraderClass {
  id           Int           @id @default(autoincrement())
  key          String // π.χ. «C_HOTEL», «S_CRAFT»
  sodtype      Int // 13 πελάτες · 12 προμηθευτές
  level        Int // βάθος στο δέντρο (1 = ρίζα)
  sohCode      String? // «Κωδικός ιεραρχίας» SoftOne, π.χ. «20.3.02»
  code         String // σύντμηση (CODE) στο SoftOne
  name         String
  description  String?
  parentId     Int?
  parent       TraderClass?  @relation("TraderClassTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     TraderClass[] @relation("TraderClassTree")
  softoneField String // TRDBUSINESS
  softoneId    Int? // το κλειδί της εγγραφής στο SoftOne (null = δεν έχει δημιουργηθεί ακόμα)
  kadPrefixes  String[]      @default([]) // κανόνες ΚΑΔ (μόνο φύλλα, για εμφάνιση)
  order        Int           @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  assignments TraderClassAssignment[]

  @@unique([key, sodtype])
  @@index([sodtype, isActive, level, order])
  @@index([parentId])
}

// ΚΑΔ ΑΑΔΕ + προτεινόμενη κατηγορία ανά συναλλασσόμενο (αποτέλεσμα της αυτόματης ανάθεσης).
// Η ανάθεση στο SoftOne (TRDR.TRDBUSINESS) γίνεται ΜΟΝΟ μετά από έγκριση.
model TraderClassAssignment {
  id              Int          @id @default(autoincrement())
  trdr            Int          @unique // SoftOne TRDR
  sodtype         Int
  code            String // TRDR.CODE
  name            String
  afm             String?
  afmKind         String // greek | foreign | invalid | none
  countryIso      String?
  aadeName        String?
  aadeCheckedAt   DateTime?
  primaryKad      String? // «55.10.10.01»
  primaryKadDescr String?
  activities      Json? // όλοι οι ΚΑΔ της ΑΑΔΕ [{code, descr, kind}]
  purchasesHint   Json? // προμηθευτές: τι αγοράζουμε (κορυφαία είδη)
  leafId          Int?
  leaf            TraderClass? @relation(fields: [leafId], references: [id], onDelete: SetNull)
  pathKeys        String[]     @default([]) // κλειδιά από τη ρίζα μέχρι το φύλλο
  basis           String // kad | purchases | legal_form | no_afm | …
  rule            String?
  needsReview     Boolean      @default(false)
  status          String       @default("PROPOSED") // PROPOSED | APPROVED | APPLIED
  appliedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([sodtype])
  @@index([leafId])
  @@index([needsReview])
}

// Προϊόντα ανά προμηθευτή — καθρέφτης από τα παραστατικά αγορών του SoftOne (FINDOC 1251 → MTRLINES).
// Μία γραμμή ανά (προμηθευτής, είδος). Ποσότητα/αξία ΜΟΝΟ από τιμολόγια μείον πιστωτικά (όπως η
// «Αγορές» του είδους — lib/purchase-kinds.ts)· `docs` μετρά κάθε παραστατικό (και παραγγελίες/δελτία).
// Ξαναχτίζεται ολόκληρος σε κάθε συγχρονισμό (lib/softone-sync/supplier-products.ts).
model SupplierProduct {
  id           Int       @id @default(autoincrement())
  trdr         Int // προμηθευτής (TRDR)
  mtrl         Int // είδος/υπηρεσία (MTRL)
  docs         Int       @default(0) // παραστατικά αγορών με το είδος (κάθε τύπου)
  invoiceQty   Float     @default(0) // ποσότητα τιμολογίων − πιστωτικών επιστροφής
  invoiceValue Float     @default(0) // καθαρή αξία τιμολογίων − πιστωτικών
  lastCost     Float? // κόστος μονάδας στο πιο πρόσφατο τιμολόγιο
  firstDate    DateTime?
  lastDate     DateTime?
  syncedAt     DateTime  @default(now())

  @@unique([trdr, mtrl])
  @@index([trdr, invoiceValue(sort: Desc)])
  @@index([mtrl])
}

// ── Ομάδες ειδών / υπηρεσιών (SoftOne MTRGROUP) σε ιεραρχία με SOHCODE — ΠΡΟΤΑΣΗ ─────────────────────
// Ορισμός και κανόνες ονόματος: `lib/item-groups.ts`. Οι ομάδες ΔΕΝ γράφονται από την εφαρμογή στο
// SoftOne (το setData σε ITEGROUP/SRVGROUP έσβησε γραμμή — atelier 2026-10-17): δημιουργούνται από το
// SoftOne και εδώ μόνο συνδέονται (`softoneId`). Η εμπορική κατηγορία (MTRCATEGORY) δεν αγγίζεται.
model ItemGroup {
  id          Int         @id @default(autoincrement())
  key         String // π.χ. «G_TILES», «V_APPLY»
  sodtype     Int // 51 είδη · 52 υπηρεσίες
  level       Int // βάθος (1 = κορυφή)
  sohCode     String // «Κωδικός ιεραρχίας», π.χ. «1.01»
  code        String // σύντμηση (CODE ≤ 10)
  name        String
  description String?
  parentId    Int?
  parent      ItemGroup?  @relation("ItemGroupTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    ItemGroup[] @relation("ItemGroupTree")
  softoneId   Int? // MTRGROUP στο SoftOne (null = δεν υπάρχει ακόμα)
  order       Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  assignments ItemGroupAssignment[]

  @@unique([key, sodtype])
  @@index([sodtype, isActive, level, order])
  @@index([parentId])
}

// Πρόταση ομάδας ανά είδος/υπηρεσία (από το όνομα και τους προμηθευτές). PROPOSED → APPROVED → APPLIED.
model ItemGroupAssignment {
  id               Int        @id @default(autoincrement())
  mtrl             Int        @unique
  sodtype          Int
  code             String
  name             String
  groupId          Int?
  group            ItemGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  basis            String // name | supplier | none
  rule             String?
  needsReview      Boolean    @default(false)
  looksLikeService Boolean    @default(false)
  status           String     @default("PROPOSED")
  appliedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([groupId])
  @@index([sodtype, status])
}

// ── Εργασίες έργου (Tasks) — δικά μας δεδομένα, ΔΕΝ γράφονται στο SoftOne ──────────────────────────
// Χρονοπρογραμματισμός (εξαρτήσεις, εργάσιμες ημέρες), φάσεις Kanban και templates: `lib/project-tasks-core.ts`.
model ProjectTask {
  id              String    @id @default(cuid())
  prjc            Int // SoftOne PRJC του έργου
  name            String
  description     String?
  startDate       DateTime? @db.Date // κενό = όσο νωρίτερα επιτρέπουν οι εξαρτήσεις
  durationValue   Float     @default(1) // χρόνος υλοποίησης
  durationUnit    String    @default("DAYS") // DAYS (εργάσιμες) · HOURS (8 ώρες = 1 ημέρα)
  progress        Int       @default(0) // 0 · 25 · 50 · 75 · 100 — ορίζει και τη στήλη Kanban
  sortOrder       Int       @default(0) // σειρά μέσα στη στήλη
  customerVisible Boolean   @default(false) // φαίνεται στο portal του πελάτη του έργου
  inCalendar      Boolean   @default(false) // στο ημερολόγιο ραντεβού + πρόσκληση .ics στους υπαλλήλους
  icsSequence     Int       @default(0)
  completedAt     DateTime?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  parties     ProjectTaskParty[]
  files       ProjectTaskFile[]
  dependsOn   ProjectTaskDependency[] @relation("TaskSuccessor")
  requiredFor ProjectTaskDependency[] @relation("TaskPredecessor")

  @@index([prjc, sortOrder])
  @@index([inCalendar, startDate])
}

// «Γίνεται αφού ολοκληρωθεί»: το taskId ξεκινά μετά το τέλος του dependsOnId (finish-to-start).
model ProjectTaskDependency {
  taskId      String
  task        ProjectTask @relation("TaskSuccessor", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId String
  dependsOn   ProjectTask @relation("TaskPredecessor", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
  @@index([dependsOnId])
}

// Εμπλεκόμενοι: EMPLOYEE (User) · PARTNER (Partner) · SUPPLIER / CUSTOMER (SoftOne TRDR).
model ProjectTaskParty {
  id        String      @id @default(cuid())
  taskId    String
  task      ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind      String
  userId    String?
  partnerId String?
  trdr      Int?

  @@index([taskId])
  @@index([userId])
  @@index([partnerId])
  @@index([trdr])
}

// Αρχεία task: ζουν στον φάκελο του έργου (EntityFile, Bunny)· εδώ μόνο ο σύνδεσμος.
model ProjectTaskFile {
  taskId String
  task   ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileId String
  file   EntityFile  @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([taskId, fileId])
  @@index([fileId])
}

// Templates εργασιών: ονομασμένο σύνολο tasks με σχετική έναρξη (εργάσιμες από την αρχή) και εξαρτήσεις.
model TaskTemplate {
  id          String             @id @default(cuid())
  name        String             @unique
  description String?
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  items       TaskTemplateItem[]
}

model TaskTemplateItem {
  id              String       @id @default(cuid())
  templateId      String
  template        TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key             String // τοπικό κλειδί μέσα στο template (για τις εξαρτήσεις)
  name            String
  description     String?
  durationValue   Float        @default(1)
  durationUnit    String       @default("DAYS")
  offsetDays      Int          @default(0) // εργάσιμες από την έναρξη του template
  customerVisible Boolean      @default(false)
  inCalendar      Boolean      @default(false)
  sortOrder       Int          @default(0)
  dependsOn       String[]     @default([]) // κλειδιά άλλων items

  @@unique([templateId, key])
  @@index([templateId, sortOrder])
}

// Διάταξη της αρχικής (/admin) ανά χρήστη: σειρά, κρυμμένα, μέγεθος widgets (lib/dashboard/widgets.ts).
model DashboardLayout {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  layout    Json // { order: string[], hidden: string[], sizes: Record<string, 'sm'|'md'|'lg'> }
  updatedAt DateTime @updatedAt
}

// ============================================================
// Συμβάσεις & Προσφορές έργων — ΔΙΚΑ ΜΑΣ δεδομένα. Ένα έγγραφο σε δύο στάδια: OFFER (προσφορά προς
// τον πελάτη) → CONTRACT (με την αποδοχή). Το έργο ζει εδώ μέχρι να συνδεθεί με PRJC του SoftOne
// (υπάρχον ή νέο — η δημιουργία στο SoftOne γίνεται ΜΟΝΟ με ρητή επιβεβαίωση του χρήστη).
// Τύποι: PRODUCT (μόνο προϊόν) · PRODUCT_INSTALL (προϊόν + τοποθέτηση) · SUBCONTRACT (τοποθέτηση
// από τεχνικές εταιρίες/συνεργεία για λογαριασμό μας).
// ============================================================
model Contract {
  id            String    @id @default(cuid())
  number        Int       @unique @default(autoincrement()) // «ΣΥΜ-000123»
  title         String
  summary       String    @default("")
  kind          String // PRODUCT · PRODUCT_INSTALL · SUBCONTRACT
  stage         String    @default("OFFER") // OFFER · CONTRACT
  /// DRAFT → SENT → ACCEPTED (γίνεται CONTRACT) → ACTIVE → COMPLETED · CANCELLED
  status        String    @default("DRAFT")
  trdr          Int? // πελάτης SoftOne
  customerName  String? // στιγμιότυπο (ή πελάτης εκτός SoftOne)
  customerEmail String?
  customerPhone String?
  prjc          Int? // συνδεδεμένο έργο SoftOne
  /// Δυνητικός πελάτης (μόνο στην εφαρμογή) — με την αποδοχή γίνεται πελάτης SoftOne και γεμίζει το `trdr`.
  prospectId    Int?
  prospect      Prospect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  // Τοποθεσία (ίδια μορφή με ProjectSite — αντιγράφεται εκεί όταν συνδεθεί PRJC)
  siteAddress   String?
  siteZip       String?
  siteDistrict  String?
  siteCity      String?
  siteFormatted String?
  siteLat       Float?
  siteLng       Float?
  siteSource    String?
  /// Η αποθηκευμένη τοποθεσία του πελάτη (πύλη) — τα site* παραπάνω είναι το στιγμιότυπο της διεύθυνσης.
  customerSiteId String?
  customerSite   CustomerSite? @relation(fields: [customerSiteId], references: [id], onDelete: SetNull)
  sitePrecision String?
  startDate     DateTime? @db.Date
  endDate       DateTime? @db.Date
  validUntil    DateTime? @db.Date // ισχύς προσφοράς
  vatRate       Float     @default(24)
  terms         String? // ειδικοί όροι που θέλει ο χρήστης να μπουν στη σύμβαση
  /// Ευανάγνωστη περιγραφή του έργου για τον πελάτη (AI από περίληψη + χώρους + γραμμές, διορθώσιμη)
  customerText  String?
  /// Τρέχουσα έκδοση (σε επεξεργασία). Οι «παγωμένες» εκδόσεις ζουν στο ContractRevision.
  revision      Int       @default(1)
  /// Επιλογή ανά ομάδα εναλλακτικών ({ "room:abc": "B" }) — λείπει = A. Την ορίζει ο πελάτης (πύλη) ή το προσωπικό.
  optionChoices Json      @default("{}")
  acceptedAt    DateTime?
  activatedAt   DateTime?
  completedAt   DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lines       ContractLine[]
  parties     ContractParty[]
  members     ContractMember[]
  milestones  ContractMilestone[]
  documents   ContractDocument[]
  /// Χαρτογράφηση κάτοψης από την οποία βγήκε (κάτοψη & χώροι στο PDF πελάτη και συνεργείων).
  floorPlanId String?
  floorPlan   FloorPlan?          @relation(fields: [floorPlanId], references: [id], onDelete: SetNull)
  rfps        Rfp[]
  revisions   ContractRevision[]
  tasks       ContractTask[]
  notes       ContractNote[]
  messages    Message[]
  events      ContractEvent[]

  @@index([prjc])
  @@index([trdr])
  @@index([prospectId])
  @@index([status])
  @@index([floorPlanId])
  @@index([customerSiteId])
}

/// Χρονοδιάγραμμα της προσφοράς (πριν από την αποδοχή): εργασίες με διάρκεια, έναρξη ή εξαρτήσεις
/// (Gantt). Με την ενεργοποίηση γίνονται εργασίες του έργου (`projectTaskId`), μαζί με τις φωτογραφίες.
model ContractTask {
  id              String    @id @default(cuid())
  contractId      String
  contract        Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  durationValue   Float     @default(1)
  durationUnit    String    @default("DAYS")
  startDate       DateTime? @db.Date
  /// id άλλων ContractTask (finish-to-start)
  dependsOn       String[]  @default([])
  /// Χώρος της κάτοψης που αφορά (προαιρετικό)
  roomId          String?
  customerVisible Boolean   @default(true)
  /// Φωτογραφίες (EntityFile) — π.χ. από σημείωση της κάτοψης
  photoFileIds    String[]  @default([])
  sortOrder       Int       @default(0)
  projectTaskId   String?

  @@index([contractId, sortOrder])
}

/// Σημείωση / ειδική οδηγία σε σημείο της προσφοράς (γενικά, χώρος, πληρωμή, εργασία) — από τον
/// χρήστη ή τον πελάτη (portal). `shareWith`: ποιος τη βλέπει πέρα από εμάς — CUSTOMER και/ή PARTY:<id>.
model ContractNote {
  id           String    @id @default(cuid())
  contractId   String
  contract     Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// CONTRACT · ROOM · MILESTONE · TASK
  targetType   String    @default("CONTRACT")
  targetId     String?
  targetLabel  String?
  /// NOTE · INSTRUCTION (μπαίνει στα έγγραφα) · QUESTION (ερώτηση πελάτη) · CHANGE (αίτημα αλλαγής πελάτη)
  kind         String    @default("NOTE")
  /// Απάντηση σε άλλη σημείωση (νήμα συζήτησης)
  replyToId    String?
  /// Η έκδοση της προσφοράς πάνω στην οποία γράφτηκε
  revision     Int?
  body         String
  shareWith    String[]  @default([])
  photoFileIds String[]  @default([])
  /// Η εργασία του χρονοδιαγράμματος που φτιάχτηκε από τη σημείωση
  taskId       String?
  /// STAFF · CUSTOMER
  authorKind   String
  authorId     String?
  authorName   String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([contractId, createdAt])
  @@index([replyToId])
}

/// Ιστορικό προσφοράς/σύμβασης: συμβάντα που δεν είναι μηνύματα (αποστολή έκδοσης, αποδοχή, αναπροσαρμογή,
/// ενεργοποίηση…). Μαζί με τις σημειώσεις (ContractNote) σχηματίζουν το ιστορικό επικοινωνίας. Δεν σβήνεται.
model ContractEvent {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// SENT · ACCEPTED · REVISED · AI_REVISED · RESTORED · ACTIVATED · COMPLETED · CANCELLED · RESOLVED · REOPENED
  type       String
  /// STAFF · CUSTOMER · SYSTEM
  actorKind  String
  actorId    String?
  actorName  String?
  summary    String
  /// Ορατό στον πελάτη (π.χ. «στάλθηκε η έκδοση 3») — τα εσωτερικά όχι
  customer   Boolean  @default(false)
  revision   Int?
  refId      String?
  createdAt  DateTime @default(now())

  @@index([contractId, createdAt])
}

/// Παγωμένη έκδοση προσφοράς/σύμβασης: ολόκληρη η φόρμα (σχήμα contractInput) τη στιγμή που στάλθηκε,
/// συντάχθηκε PDF ή ζητήθηκε «Νέα έκδοση». Η επόμενη αποθήκευση γίνεται σε νέα (revision + 1).
model ContractRevision {
  id          String   @id @default(cuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  revision    Int
  /// MANUAL · SENT · DOCUMENT · RESTORE
  reason      String   @default("MANUAL")
  note        String?
  snapshot    Json
  net         Float    @default(0)
  gross       Float    @default(0)
  lineCount   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([contractId, revision])
}

// Χαρτογράφηση κάτοψης έργου (εργαλείο «Διαστασιολόγηση κάτοψης») — ΔΙΚΑ ΜΑΣ δεδομένα. `data` = όλη η
// κατάσταση του εργαλείου (χώροι/περιγράμματα σε pixels ανάλυσης, τοίχοι, διαχωριστικά, κλίμακα,
// υλικά, πλακάκι τοίχων) — σχήμα στο `lib/floorplan/saved.ts`. Οι εικόνες ζουν στα αρχεία του έργου
// (υποφάκελος «Κατόψεις»): `imageFileId` = το σχέδιο χωρίς σημειώσεις (για ξανάνοιγμα),
// `annotatedFileId` = με χώρους και υπόμνημα (PDF προσφοράς/συνεργείων, προβολή), `sourceFileId` = το
// πρωτότυπο (φωτογραφία σχεδίου/PDF).
model FloorPlan {
  id              String     @id @default(cuid())
  /// Έργο SoftOne· κενό όταν η χαρτογράφηση έγινε για προσφορά πελάτη πριν υπάρξει έργο.
  prjc            Int?
  /// Πελάτης SoftOne (χαρτογράφηση από το μενού του πελάτη)· μένει και όταν συνδεθεί έργο.
  trdr            Int?
  /// Δυνητικός πελάτης (προσφορά πριν υπάρξει στο SoftOne)· με τη μετατροπή συμπληρώνεται και το `trdr`.
  prospectId      Int?
  title           String
  source          String?
  data            Json
  floorM2         Float      @default(0)
  wallsM2         Float      @default(0)
  roomCount       Int        @default(0)
  imageFileId     String?
  annotatedFileId String?
  /// Το αρχείο που ανέβασε ο χρήστης όπως ήταν (φωτογραφία σχεδίου ή PDF) — βάση της διαστασιολόγησης.
  sourceFileId    String?
  createdById     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  contracts       Contract[]

  @@index([prjc, updatedAt])
  @@index([trdr, updatedAt])
  @@index([prospectId, updatedAt])
}

// Δυνητικός πελάτης: ζει ΜΟΝΟ στην εφαρμογή όσο οι προσφορές του δεν έχουν γίνει αποδεκτές. Με την
// αποδοχή γράφεται στο SoftOne ως πελάτης (ή συνδέεται με υπάρχοντα, ίδιο ΑΦΜ/email) — `trdr` +
// `convertedAt` — και οι προσφορές, οι κατόψεις και τα αρχεία του περνούν στον πελάτη. Λογική στο
// `lib/prospects.ts`· αρχεία στον φάκελο `prospects/<id>-…` (EntityFolder PROSPECT) μέχρι τη μετατροπή.
model Prospect {
  id          Int        @id @default(autoincrement())
  /// Επωνυμία εταιρίας ή ονοματεπώνυμο ιδιώτη — γίνεται NAME του πελάτη στο SoftOne.
  name        String
  /// Υπεύθυνος επικοινωνίας (όταν ο πελάτης είναι εταιρία).
  contactName String?
  email       String?
  phone       String?
  afm         String?
  doy         String?
  profession  String?
  address     String?
  zip         String?
  city        String?
  notes       String?
  /// Από ποιο lead του website προήλθε (αν προήλθε).
  leadId      String?
  /// Πελάτης SoftOne μετά τη μετατροπή (νέος ή υπάρχων που ταίριαξε σε ΑΦΜ/email).
  trdr        Int?
  convertedAt DateTime?
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  contracts   Contract[]

  @@index([name])
  @@index([trdr])
}

// Υλικά & υπηρεσίες. Όνομα/μονάδα ως στιγμιότυπο. `partyId` = το συνεργείο που εκτελεί τη γραμμή,
// `crewFee` = η αμοιβή του για αυτή (μπαίνει στη δική του σύμβαση, ΠΟΤΕ στου πελάτη).
model ContractLine {
  id         String         @id @default(cuid())
  contractId String
  contract   Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  kind       String // MATERIAL · SERVICE
  mtrl       Int?
  code       String?
  name       String
  unit       String?
  qty        Float          @default(1)
  unitPrice  Float          @default(0)
  discount   Float          @default(0) // %
  notes      String?
  partyId    String?
  party      ContractParty? @relation(fields: [partyId], references: [id], onDelete: SetNull)
  crewFee    Float?
  /// Χώρος της κάτοψης (FloorPlan.data.rooms[].id) που παρήγαγε τη γραμμή — ξαναϋπολογίζεται μαζί του.
  roomId     String?
  /// Εναλλακτικές επιλογές: ομάδα («room:<id>» ή «line:<key>») και επιλογή A/B. Κενό = πάντα μέσα.
  optionGroup String?
  option      String?
  /// Η επιλογή της ομάδας που ΔΕΝ έχει διαλεχτεί (Contract.optionChoices): εκτός συνόλων, PDF, έργου.
  inactive    Boolean        @default(false)
  sortOrder  Int            @default(0)

  @@index([contractId, sortOrder])
}

// Συνεργεία / τεχνικές εταιρίες / μάστοροι: προμηθευτής SoftOne (TRDR) ή Συνεργάτης (Partner).
model ContractParty {
  id         String              @id @default(cuid())
  contractId String
  contract   Contract            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  kind       String // SUPPLIER · PARTNER
  trdr       Int?
  partnerId  String?
  name       String
  email      String?
  phone      String?
  afm        String?
  specialty  String?
  scope      String? // τι αναλαμβάνει (ελεύθερο κείμενο, πέρα από τις γραμμές)
  sortOrder  Int                 @default(0)
  lines      ContractLine[]
  milestones ContractMilestone[]
  documents  ContractDocument[]

  @@index([contractId])
}

// Προσωπικό του έργου: παίρνει τα tasks και τις εγγραφές ημερολογίου των milestones.
model ContractMember {
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  userId     String

  @@id([contractId, userId])
  @@index([userId])
}

// Milestones: παραδοτέο + πληρωμή. `partyId` κενό = πληρωμή του πελάτη προς εμάς· αλλιώς πληρωμή
// δική μας προς το συνεργείο. Με την ενεργοποίηση της σύμβασης γίνονται ProjectTask (στο ημερολόγιο).
model ContractMilestone {
  id            String         @id @default(cuid())
  contractId    String
  contract      Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  partyId       String?
  party         ContractParty? @relation(fields: [partyId], references: [id], onDelete: Cascade)
  title         String
  deliverables  String?
  dueDate       DateTime?      @db.Date
  amount        Float          @default(0)
  status        String         @default("PENDING") // PENDING · DONE · PAID
  taskId        String? // ProjectTask που δημιουργήθηκε
  doneAt        DateTime?
  paidAt        DateTime?
  /// Απόδειξη παράδοσης: τι παραδόθηκε (περιγραφή) και φωτογραφίες (EntityFile, φάκελος «Παραδόσεις»).
  deliveryNote  String?
  deliveredById String?
  proofFileIds  String[]       @default([])
  sortOrder     Int            @default(0)

  @@index([contractId, sortOrder])
}

// ── Αιτήματα προσφοράς (RFP) προς τεχνικές εταιρίες / συνεργεία / μαστόρους ─────────────────────────
// Για μια προσφορά/σύμβαση ζητάμε τιμή από συνεργεία: specs σε PDF ΧΩΡΙΣ τις τιμές μας (εργασίες με
// ποσότητες, κάτοψη & χώροι, περιοχή — όχι το όνομα του πελάτη) + μοναδικός σύνδεσμος ανά παραλήπτη.
// Ο παραλήπτης απαντά (ποσό χωρίς ΦΠΑ, έναρξη, διάρκεια, σχόλια, αποδοχή όρων) από τον σύνδεσμο ή
// από το portal του. Κάθε ενέργεια γράφεται στο RfpEvent με IP, browser, session και αλυσίδα hash
// (απόδειξη). Η «Ανάθεση» κάνει τον παραλήπτη συνεργείο της σύμβασης. Λογική: lib/rfp/*.
model Rfp {
  id                 String         @id @default(cuid())
  number             Int            @unique @default(autoincrement()) // «ΑΠΡ-000123»
  contractId         String
  contract           Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title              String
  scope              String         @default("") // τι ζητάμε (εμφανίζεται στο PDF, στο email και στη σελίδα)
  dueDate            DateTime?      @db.Date // προθεσμία απάντησης
  status             String         @default("OPEN") // OPEN · AWARDED · CLOSED · CANCELLED
  specsFileId        String? // EntityFile (PDF specs)
  specsFileName      String?
  specsSha256        String? // αποτύπωμα του PDF που είδε/αποδέχτηκε ο παραλήπτης
  awardedRecipientId String?
  createdById        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  recipients         RfpRecipient[]

  @@index([contractId])
}

model RfpRecipient {
  id            String     @id @default(cuid())
  rfpId         String
  rfp           Rfp        @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  kind          String // SUPPLIER · PARTNER
  trdr          Int?
  partnerId     String?
  name          String
  email         String?
  phone         String?
  afm           String?
  specialty     String?
  /// SHA-256 του μοναδικού token του συνδέσμου (το ίδιο το token δεν αποθηκεύεται).
  tokenHash     String     @unique
  /// INVITED · VIEWED · SUBMITTED · DECLINED · AWARDED · NOT_AWARDED
  status        String     @default("INVITED")
  amount        Float? // χωρίς ΦΠΑ
  startDate     DateTime?  @db.Date
  durationDays  Int?
  notes         String?
  termsAccepted Boolean    @default(false)
  viewedAt      DateTime?
  submittedAt   DateTime?
  declinedAt    DateTime?
  sends         Json       @default("[]") // [{ to, at, by, result }]
  partyId       String? // ContractParty μετά την ανάθεση
  createdAt     DateTime   @default(now())
  events        RfpEvent[]

  @@index([rfpId])
  @@index([trdr])
  @@index([partnerId])
}

/// Ημερολόγιο συνεδρίας (απόδειξη): κάθε γεγονός «δένεται» με το προηγούμενο (hash = sha256(prevHash + δεδομένα)).
model RfpEvent {
  id          String       @id @default(cuid())
  recipientId String
  recipient   RfpRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  /// INVITED · EMAIL_SENT · LINK_RENEWED · OPEN · SPECS_DOWNLOAD · SUBMIT · DECLINE · AWARDED · NOT_AWARDED
  type        String
  at          DateTime     @default(now())
  actor       String // link · portal · staff · system
  userId      String?
  ip          String?
  userAgent   String?
  sessionId   String?
  data        Json         @default("{}")
  prevHash    String?
  hash        String

  @@index([recipientId, at])
}

// Έγγραφα που συνέταξε το AI: CUSTOMER (προσφορά/σύμβαση πελάτη) ή PARTY (σύμβαση συνεργείου).
// Το περιεχόμενο είναι δομημένο JSON (lib/contracts/doc.ts)· τα ποσά/γραμμές έρχονται ΠΑΝΤΑ από τη
// βάση στο PDF, όχι από το AI. Το PDF ζει στα αρχεία του έργου (ή του πελάτη, πριν από το PRJC).
model ContractDocument {
  id          String         @id @default(cuid())
  contractId  String
  contract    Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  audience    String // CUSTOMER · PARTY
  partyId     String?
  party       ContractParty? @relation(fields: [partyId], references: [id], onDelete: Cascade)
  stage       String // OFFER · CONTRACT (το στάδιο τη στιγμή της σύνταξης)
  version     Int            @default(1)
  /// Η έκδοση της προσφοράς (Contract.revision) από την οποία συντάχθηκε.
  revision    Int?
  content     Json
  model       String?
  fileId      String? // EntityFile (PDF)
  fileName    String?
  sends       Json           @default("[]") // [{ to, at, by, result }]
  createdById String?
  createdAt   DateTime       @default(now())

  @@index([contractId, audience, partyId])
}

// ── Συνταγές τοποθέτησης — ΔΙΚΑ ΜΑΣ δεδομένα (όχι SoftOne) ─────────────────────────────────────────
// Ανά τετραγωνικό: κύριο υλικό (πλακάκι / πέτρα / τσιμεντοκονία) με φύρα, βοηθητικά υλικά (κόλλα,
// αρμόστοκος, αστάρι…) με ποσότητα/m² και φύρα, και εργατικό κόστος/m². Οι υπολογισμοί: `lib/install-recipes-core.ts`.
// Κωδικός, όνομα και μονάδα των ειδών κρατιούνται ως στιγμιότυπο από τον καθρέφτη (`SoftoneItem`).
enum RecipeMaterialKind {
  TILE // πλακάκι
  STONE // πέτρα
  CEMENT_MORTAR // τσιμεντοκονία
}

model InstallRecipe {
  id              String              @id @default(cuid())
  name            String
  kind            RecipeMaterialKind
  description     String?
  // Κύριο υλικό (MTRL) — null = γενική συνταγή για όλη την κατηγορία
  mtrl            Int?
  mtrlCode        String?
  mtrlName        String?
  mtrlUnit        String?
  materialPrice   Float               @default(0) // τιμή κύριου υλικού ανά m²
  wastePct        Float               @default(0) // φύρα κύριου υλικού (%)
  laborCostPerSqm Float               @default(0) // εργατικό κόστος ανά m²
  // Υπηρεσία (MTRL) με την οποία μπαίνουν τα εργατικά στον προϋπολογισμό έργου — προαιρετική
  laborMtrl       Int?
  laborCode       String?
  laborName       String?
  copiedFromId    String? // συνταγή-πηγή όταν φτιάχτηκε με αντιγραφή
  createdById     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  lines           InstallRecipeLine[]

  @@index([kind, name])
  @@index([mtrl])
}

model InstallRecipeLine {
  id        String        @id @default(cuid())
  recipeId  String
  recipe    InstallRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  mtrl      Int // SoftOne MTRL (βοηθητικό υλικό)
  code      String
  name      String
  unit      String?
  qtyPerSqm Float // ποσότητα ανά m² (στη βασική μονάδα του είδους)
  wastePct  Float         @default(0) // φύρα (%)
  unitPrice Float         @default(0) // τιμή ανά μονάδα
  notes     String?
  sortOrder Int           @default(0)

  @@index([recipeId, sortOrder])
}

/// Έγκριση (ή απόρριψη) καταχώρισης παραστατικού, ανά επίπεδο (βλ. lib/ocr/approvals.ts). Το
/// `fingerprint` δένει την έγκριση με ΑΥΤΑ τα ποσά/εκδότη/γραμμές: αν αλλάξουν, η έγκριση δεν ισχύει.
model OcrApproval {
  id          String      @id @default(cuid())
  documentId  String
  document    OcrDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  level       Int
  /// APPROVED | REJECTED
  decision    String
  userId      String?
  userEmail   String?
  roleKey     String?
  comment     String?
  fingerprint String
  createdAt   DateTime    @default(now())

  @@index([documentId])
}

// Επικοινωνία από τη διαχείριση με πελάτη, συνεργείο ή συνεργάτη — ανά έργο ή/και πελάτη (και προαιρετικά
// προσφορά). Κανάλια: email και/ή μήνυμα στην πύλη· ή μόνο καταγραφή (π.χ. τηλεφώνημα). Μπαίνει στο ιστορικό.
model Message {
  id                String    @id @default(cuid())
  prjc              Int?
  trdr              Int?
  contractId        String?
  contract          Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  /// CUSTOMER · SUPPLIER · PARTNER · INTERNAL
  audience          String
  /// SEND (αποστολή) · LOG (καταγραφή επικοινωνίας που έγινε αλλού, π.χ. τηλέφωνο)
  kind              String    @default("SEND")
  toName            String?
  toEmail           String?
  /// Για συνεργείο/συνεργάτη: ποιο (TRDR προμηθευτή ή Partner.id)
  partyRef          String?
  viaEmail          Boolean   @default(false)
  viaPortal         Boolean   @default(false)
  /// SENT · BLOCKED (πριν το live) · FAILED · null (χωρίς email)
  emailStatus       String?
  subject           String
  body              String
  attachmentFileIds String[]  @default([])
  /// Κοινοποίηση (Cc) — email
  cc                String[]  @default([])
  /// Μορφοποιημένο κείμενο (καθαρισμένο HTML)· το `body` κρατά το απλό κείμενο
  bodyHtml          String?
  /// Μυστικός κωδικός: στο θέμα «[#ΚΩΔ]», στο Reply-To (reply+κωδ@…) και στο X-DG-Ref — συνδέει μελλοντικές απαντήσεις
  replyCode         String?   @unique
  authorId          String?
  authorName        String?
  createdAt         DateTime  @default(now())

  @@index([prjc, createdAt])
  @@index([trdr, createdAt])
  @@index([contractId])
}
